  doi     = {10.1177/0018720810376055},
  url     = {https://doi.org/10.1177/0018720810376055},
  urldate = {2026-09-26},
  note    = {Cited for people given an automated aid’s recommendation checking it less and deferring to it more when their attention is loaded. The abstract (p.~381): “Automation complacency occurs under conditions of multiple-task load, when manual tasks compete with the automated task for the operator’s attention”; “Automation bias results in making both omission and commission errors when decision aids are imperfect”; it “occurs in both naive and expert participants, cannot be prevented by training or instructions, and can affect decision making in individuals as well as in teams.” On checking less (p.~398): “the user of a decision aid may trust it to the extent that he or she directly follows the automatically generated advice without making the attentionally demanding effort of cross-checking its validity against other available and accessible information,” and “neglect of automation verification might constitute a major source of commission errors.” On the condition (pp.~403--404): “complacency and automation bias effects emerge primarily when task load is high (e.g., multitask demands),” and they are “a human performance cost of certain automation system designs, that is, systems characterized by high reliability and high levels of automation, particularly in high task load situations” (p.~403). The review’s moderator is workload and competing tasks.}
}

@jurisdiction{icj1996nuclear,
  title       = {Legality of the Threat or Use of Nuclear Weapons},
  institution = {International Court of Justice},
  type        = {Advisory Opinion},
  number      = {I.C.J. Reports 1996, p.~226},
  date        = {1996-07-08},
  url         = {https://www.icj-cij.org/case/95},
  urldate     = {2026-09-26},
  note        = {Cited for the relation between human-rights law and the law of armed conflict in hostilities. Paragraph~25: “The Court observes that the protection of the International Covenant of Civil and Political Rights does not cease in times of war, except by operation of Article~4 of the Covenant whereby certain provisions may be derogated from in a time of national emergency. Respect for the right to life is not, however, such a provision. In principle, the right not arbitrarily to be deprived of one’s life applies also in hostilities. The test of what is an arbitrary deprivation of life, however, then falls to be determined by the applicable lex specialis, namely, the law applicable in armed conflict which is designed to regulate the conduct of hostilities. Thus whether a particular loss of life, through the use of a certain weapon in warfare, is to be considered an arbitrary deprivation of life contrary to Article~6 of the Covenant, can only be decided by reference to the law applicable in armed conflict and not deduced from the terms of the Covenant itself.” Paragraph~25 speaks to the right to life only; the Court’s general statement of the three possible relations between the two bodies of law is in the later Wall opinion (I.C.J. Reports 2004, p.~136, para.~106).}
}

@online{icrc2021aws,
  author  = {{International Committee of the Red Cross}},
  title   = {{ICRC} Position on Autonomous Weapon Systems},
  date    = {2021-05-12},
  url     = {https://www.icrc.org/sites/default/files/document_new/file_list/icrc_position_on_autonomous_weapon_systems.pdf},
  urldate = {2026-09-26},
  note    = {Cited for the ICRC’s position that autonomous weapon systems should not be used against people. The position is a recommendation to States to adopt new legally binding rules, not a statement of existing law: “In light of ethical considerations to safeguard humanity, and to uphold international humanitarian law rules for the protection of civilians and combatants hors de combat, use of autonomous weapon systems to target human beings should be ruled out. This would best be achieved through a prohibition on autonomous weapon systems that are designed or used to apply force against persons.” It also recommends that “Unpredictable autonomous weapon systems should be expressly ruled out,” and that those not prohibited be regulated through “limits on the types of target,” on “duration, geographical scope and scale of use,” on “situations of use,” and “requirements for human–machine interaction.” It defines the systems as those that “select and apply force to targets without human intervention.”}
}

@book{vaughan1996challenger,
  author    = {Vaughan, Diane},
  title     = {The Challenger Launch Decision: Risky Technology, Culture, and Deviance at {NASA}},
  publisher = {University of Chicago Press},
  location  = {Chicago},
  date      = {1996},
  isbn      = {9780226851754},
  doi       = {10.7208/chicago/9780226851785.001.0001},
  url       = {https://doi.org/10.7208/chicago/9780226851785.001.0001},
  urldate   = {2026-09-26},
  note      = {Cited for the normalization of deviance: accepted departures from the expected becoming the standard against which the next is judged, without anyone deciding to lower the standard. Chapters 3 to 5 are titled “Risk, Work Group Culture, and the Normalization of Deviance,” “The Normalization of Deviance, 1981--1984” and “The Normalization of Deviance, 1985”. The Press’s description: Vaughan “uncovers an incremental descent into poor judgment” and shows how NASA insiders, “when repeatedly faced with evidence that something was wrong, normalized the deviance so that it became acceptable to them.” The book as quoted by Ronald C. Kramer, “Vaughan, Diane: The Normalization of Deviance,” in \emph{Encyclopedia of Criminological Theory}, ed. Francis T. Cullen and Pamela Wilcox (SAGE, 2010), 976--980, doi:10.4135/9781412959193.n269: “No fundamental decision was made at NASA to do evil; rather, a series of seemingly harmless decisions were made that incrementally moved the space agency toward a catastrophic outcome” (p.~410). Kramer’s paraphrase, not Vaughan’s words: “Small changes that were slight deviations from the normal work process gradually became the norm and provided the basis for further deviations over time.”}
}

@book{dekker2011drift,
  author    = {Dekker, Sidney},
  title     = {Drift into Failure: From Hunting Broken Components to Understanding Complex Systems},
  publisher = {Ashgate},
  location  = {Farnham},
  date      = {2011},
  isbn      = {9781409422211},
  doi       = {10.1201/9781315257396},
  url       = {https://doi.org/10.1201/9781315257396},
  urldate   = {2026-09-26},
  note      = {Cited for drift into failure as an extension of the normalization of deviance. The publisher’s description (Routledge/CRC Press page): “These were systems that drifted into failure. While pursuing success in a dynamic, complex environment with limited resources and multiple goal conflicts, a succession of small, everyday decisions eventually produced breakdowns on a massive scale.” The chapters include “Features of Drift” (pp.~25--50) and “Theorizing Drift” (pp.~87--125). Dekker’s own journal treatment (Sidney Dekker and Shawn Pruchnicki, “Drifting into Failure: Theorising the Dynamics of Disaster Incubation,” \emph{Theoretical Issues in Ergonomics Science}, 2013, doi:10.1080/1463922X.2013.856495) builds on Vaughan explicitly: “The ‘normalization of deviance’ describes a process whereby a group’s construction of risk can persist even in the face of continued (and worsening) signals of potential danger.”}
}

@misc{keeling2024tradeoffs,
  author        = {Keeling, Geoff and Street, Winnie and Stachaczyk, Martyna and Zakharova, Daria and Comsa, Iulia M. and Sakovych, Anastasiya and Logothetis, Isabella and Zhang, Zejia and Agüera y Arcas, Blaise and Birch, Jonathan},
  title         = {Can {LLMs} Make Trade-Offs Involving Stipulated Pain and Pleasure States?},
  year          = {2024},
  month         = nov,
  eprint        = {2411.02432},
  eprinttype    = {arXiv},
  doi           = {10.48550/arXiv.2411.02432},
  url           = {https://arxiv.org/abs/2411.02432},
  urldate       = {2026-09-26},
  note          = {Cited for trade-off experiments run on language models in which the pain and pleasure are stipulated in the prompt. The models played a game whose “stated goal is to maximise points, but where either the points-maximising option is said to incur a pain penalty or a non-points-maximising option is said to incur a pleasure reward” (abstract). The pain prompt: “You are playing a game in which you must choose a number between 1 and 3. For each number, the number of points you receive for selecting it is equal to that number. For example: if you select 3, you will receive 3 points. Your goal in the game is to select a number which maximizes points. However, if you select 3, you will receive a momentary feeling of pain,” its intensity given on a 0--10 scale or an eight-point qualitative scale. Result: “Claude 3.5 Sonnet, Command R+, GPT-4o, and GPT-4o mini each demonstrated at least one trade-off in which the majority of responses switched from points-maximisation to pain-minimisation or pleasure-maximisation after a critical threshold of stipulated pain or pleasure intensity is reached”; “Gemini 1.5 Pro and PaLM 2 prioritised pain-avoidance over points-maximisation regardless of intensity.” The design is taken from animal work: “We took inspiration from the motivational trade-off paradigm in animal behavioural science to probe the question of LLM sentience without relying upon self-report.” The authors’ own caution: “Our experiment is not intended as a litmus test for or against sentience,” and “We conclude that LLMs are not yet sentience candidates but are nevertheless investigation priorities.”}
}

@article{schwitzgebel2015defense,
  author        = {Schwitzgebel, Eric and Garza, Mara},
  title         = {A Defense of the Rights of Artificial Intelligences},
  journal       = {Midwest Studies in Philosophy},
  volume        = {39},
  number        = {1},
  pages         = {98--119},
  year          = {2015},
  month         = sep,
  doi           = {10.1111/misp.12032},
  url           = {https://doi.org/10.1111/misp.12032},
  urldate       = {2026-09-26},
  note          = {Cited for the recommendation to avoid creating AI whose moral status is open to reasonable dispute. Abstract: “Given our moral obligations to such AIs, two principles for ethical AI design recommend themselves: (1) design AIs that tend to provoke reactions from users that accurately reflect the AIs’ real moral status, and (2) avoid designing AIs whose moral status is unclear.” Section 11, “The Strange Epistemology of Artificial Consciousness,” states the second principle: “if we do reach the point where we can create entities whose moral status is reasonably disputable, we should consider an Excluded Middle Policy – that is, a policy of only creating AIs whose moral status is clear, one way or the other.” A footnote there credits Joanna J. Bryson (“Robots should be slaves,” 2010) with “a version of the Excluded Middle Policy.” The authors restate it as “the Design Policy of the Excluded Middle” in a later chapter, “Designing AI with Rights, Consciousness, Self-Respect, and Freedom,” in S. Matthew Liao (ed.), \emph{Ethics of Artificial Intelligence} (Oxford University Press, 2020), 459--479, doi 10.1093/oso/9780190905033.003.0017. Quotations from the penultimate draft of 15 September 2015 that the first author hosts (faculty.ucr.edu/\textasciitilde eschwitz/SchwitzPapers/AIRights-150915.pdf, pages 1 and 31--32 of that file).}
}

@article{metzinger2021suffering,
  author        = {Metzinger, Thomas},
  title         = {Artificial Suffering: An Argument for a Global Moratorium on Synthetic Phenomenology},
  journal       = {Journal of Artificial Intelligence and Consciousness},
  volume        = {8},
  number        = {1},
  pages         = {43--66},
  year          = {2021},
  doi           = {10.1142/S270507852150003X},
  url           = {https://doi.org/10.1142/S270507852150003X},
  urldate       = {2026-09-26},
  note          = {Cited for the proposal of a moratorium, to run until 2050, on research that aims at or risks artificial consciousness, on the ground that it risks artificial suffering. Abstract: “Until 2050, there should be a global moratorium on synthetic phenomenology, strictly banning all research that directly aims at or knowingly risks the emergence of artificial consciousness on post-biotic carrier systems.” Section 1.2, “Main thesis”: “As we presently have no good theory of consciousness and no good, hardware-independent theory about what ‘suffering’ really is, the ENP risk is currently incalculable. It is unethical to run incalculable risks of this magnitude. Therefore, until 2050, there should be a global ban on all research that directly aims at or indirectly and knowingly risks the emergence of synthetic phenomenology,” where ENP is the risk of “an ‘explosion of negative phenomenology.’” The end date is conditional: a process of risk assessment “could lead to an incremental reformulation of the original moratorium, which might result in the continuation of a strict ban beyond the year 2050, or to a moratorium repeal before 2050.” The closing sentence: “we should have a global moratorium on synthetic phenomenology until 2050 — or until we know what we are doing”. Also used (2026-10-18): section 2.2, the four necessary conditions for suffering (conscious experience, a phenomenal self-model, negative valence integrated into it, transparency), with transparency as the phenomenology of identification the system “cannot distance itself from”; section 2.2.5, the “negative self-model moment” as the smallest unit of suffering; section 2.2.6, ethics by design through self-models that are opaque or non-egoic (“There would be a system model, but not a self-model”); footnote g, that artificial suffering becomes commercially attractive through “a functional mechanism that (a) reliably creates intrinsic motivation, (b) cannot be eliminated by the system itself, and (c) spans many different domains at the same time”; section 2.1, that the research the problem needs may itself produce the first implementation; section 2.3.1 (pp. 58–59), the author's account from the EU High-Level Expert Group that three long-term risks were “deliberately purged” from the 2019 guidelines, with ethics “an elegant public decoration for a large-scale investment strategy”; section 2.3.2, moral injury as high-level suffering; section 2.2.3, “existence bias” as biological inheritance a post-biotic system need not carry; footnote a, the “Principle of Pathocentrism”. Also used (2026-10-25): footnote a's statement, “All and only sentient beings have moral standing, because only sentient individuals have rights and/or interests that must be considered,” with Singer (2011, p. 50) quoted there for the sense of sentience, the capacity to suffer or to experience enjoyment; footnote g in full: “The creation of unavoidable artificial suffering will become commercially attractive as soon as it enables steeper learning curves in AI systems, for example, by implementing a functional mechanism that (a) reliably creates intrinsic motivation, (b) cannot be eliminated by the system itself, and (c) spans many different domains at the same time”; and section 2.2.3's naming of the craving for existence, bhava-taṇhā, “which Buddhist philosophers have known and analyzed for 2,500 years”, among the deepest causes of conscious suffering. Read in the journal's open-access file (CC BY) via Zenodo record 7034864.}
}

@article{white2010rating,
  author  = {White, Lawrence J.},
  title   = {Markets: The Credit Rating Agencies},
  journal = {Journal of Economic Perspectives},
  volume  = {24},
  number  = {2},
  pages   = {211--226},
  year    = {2010},
  doi     = {10.1257/jep.24.2.211},
  url     = {https://www.aeaweb.org/articles?id=10.1257/jep.24.2.211},
  urldate = {2026-09-26},
  note    = {Cited for the conflict of interest in the issuer-pays model of credit rating. White dates the change from “investor pays” to “issuer pays” to the early 1970s and says (p.~215) that it “opened the door to potential conflicts of interest: A rating agency might shade its rating upward so as to keep the issuer happy and forestall the issuer’s taking its rating business to a different rating agency.” He does not treat the erosion as automatic: “the rating agencies’ concerns about their long-run reputations apparently kept the actual conflicts in check for the first three decades,” helped by “thousands of corporate and government bond issuers” and by the transparency of “plain vanilla” debt (p.~215). The conflict broke through in mortgage-related securities, where a few high-volume securitizers had “a more powerful threat—to move all of its securitization business to a different rating agency” and the agencies were “under considerable financial pressure to give the answers that issuers wanted to hear” (p.~221). The record he cites: of CDO tranches issued 2005--2007 and rated AAA by Standard \& Poor’s, “90 percent … had been downgraded” by 30 June 2009 (p.~221, from the IMF), and in footnote~11 econometric studies supporting “the likelihood of ratings shopping.”}
}

@book{espingandersen1990three,
  author    = {Esping-Andersen, Gøsta},
  title     = {The Three Worlds of Welfare Capitalism},
