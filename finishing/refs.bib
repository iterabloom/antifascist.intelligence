@report{Birch2021CephalopodDecapod,
  author      = {Birch, Jonathan and Burn, Charlotte and Schnell, Alexandra and Browning, Heather and Crump, Andrew},
  title       = {Review of the Evidence of Sentience in Cephalopod Molluscs and Decapod Crustaceans},
  institution = {LSE Consulting, London School of Economics and Political Science},
  location    = {London},
  date        = {2021-11},
  url         = {https://www.lse.ac.uk/business/consulting/reports/review-of-the-evidence-of-sentiences-in-cephalopod-molluscs-and-decapod-crustaceans},
  urldate     = {2026-09-26},
  note        = {Commissioned by the Department for Environment, Food \& Rural Affairs (DEFRA) and externally peer-reviewed by two experts DEFRA selected. Cited for weighing over 300 studies against eight criteria of sentience, motivational trade-offs among them, and recommending that both taxa be treated as sentient. Section 1.6 (page 17) lists the criteria; the fifth: “The animal shows motivational trade-offs, in which the disvalue of a noxious or threatening stimulus is weighed (traded-off) against the value of an opportunity for reward, leading to flexible decision-making. Enough flexibility must be shown to indicate centralized, integrative processing of information involving an evaluative common currency.” The report adds: “no single criterion provides conclusive evidence of sentience by itself.” The government accepted the recommendation on 19 November 2021 and extended the Animal Welfare (Sentience) Bill to all decapod crustaceans and cephalopod molluscs. The review was commissioned in 2020 and published in November 2021.}
}

