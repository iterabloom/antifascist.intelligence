@article{eppssitaraman2019,
  author = {Epps, Daniel and Sitaraman, Ganesh},
  title = {How to Save the Supreme Court},
  journal = {Yale Law Journal},
  volume = {129},
  pages = {148--206},
  year = {2019},
  month = oct,
  url = {https://www.yalelawjournal.org/article/how-to-save-the-supreme-court},
  urldate = {2026-09-26},
  note = {Cited for the Supreme Court Lottery and for the “one supreme Court” objection to it, which the authors raise and answer themselves. The proposal (Part IV.A.1, 181): “every judge on the federal courts of appeals would also be appointed as an Associate Justice of the Supreme Court. The Supreme Court would hear cases as a panel of nine, randomly selected from all the Justices,” with panels sitting for two weeks of oral argument, no more than five Justices on a panel nominated by Presidents of one party, and “only a 6-3 supermajority of the Court, rather than a simple majority, could hold a federal statute \ldots\ unconstitutional” (182). Part IV.A.2.b, “The Vesting Clause and ‘One Supreme Court’” (188--190), states the objection — “Some contend that this provision mandates that the Supreme Court be comprised of a single set of persons rather than a rotating group of Justices” (188) — and replies that “There is a difference between having a single institution, which the Vesting Clause clearly requires, and having that institution with fixed rather than variable membership” (189). The authors argue the plan can be enacted by statute (185). Agent-verified 2026-09-26 against the published PDF from yalelawjournal.org (pagination 148--206 read from the running heads). Not read closely: Parts I--III and IV.B.}
}

@misc{nokings2024,
  author = {{United States Senate}},
  title = {No Kings Act},
  year = {2024},
  howpublished = {S.\ 4973, 118th Cong.\ (introduced Aug.\ 1, 2024; placed on the calendar Sept.\ 9, 2024)},
  url = {https://www.govinfo.gov/content/pkg/BILLS-118s4973pcs/html/BILLS-118s4973pcs.htm},
  urldate = {2026-09-26},
  note = {Cited as an example of a statute written to reverse the immunity holding of \emph{Trump v.\ United States} (2024). Introduced by Senator Schumer with 36 cosponsors, read the first time on 1 August 2024 and placed on the calendar on 9 September 2024; no further action is shown, and the 118th Congress ended without enacting it. Section 3(a)(1): a President, former President, Vice President or former Vice President “shall not be entitled to any form of immunity (whether absolute, presumptive, or otherwise) from criminal prosecution for alleged violations of the criminal laws of the United States unless specified by Congress”; \S\,3(a)(2) bars courts from considering whether the conduct was within “conclusive or preclusive constitutional authority” or “related to the official duties” of the office. Section 4 channels review: prosecutions are filed in the applicable district court or the District Court for the District of Columbia, and the Supreme Court is given “no appellate jurisdiction,” on official-act or core-power grounds, to dismiss an indictment, overturn a conviction and the like (\S\,4(a)); challenges to the Act’s constitutionality may be brought only by a President or Vice President, current or former, only within 180 days of enactment (facial) or 90 days of application, only in the District Court for the District of Columbia with appeal to the D.C. Circuit, whose decision “shall be final and not appealable to the Supreme Court,” under a clear-and-convincing presumption of constitutionality (\S\,4(b)); no State court may hear such an action and no court may grant relief sua sponte (\S\,4(c)). Findings rest the Act on the Necessary and Proper Clause and the Exceptions Clause (\S\,2(a)(2), (8)). Agent-verified 2026-09-26 against the placed-on-calendar text at govinfo. Not read: the congress.gov bill record (it refused automated access), so the absence of a House companion is not confirmed; searches found none in the 118th Congress and no reintroduction in the 119th.}
}

@misc{biden2024amendment,
  author = {{The White House}},
  title = {Fact Sheet: President Biden Announces Bold Plan to Reform the Supreme Court and Ensure No President Is Above the Law},
  year = {2024},
  month = jul,
  day = {29},
  howpublished = {White House fact sheet, 29 July 2024 (Wayback Machine capture of whitehouse.gov)},
  url = {https://web.archive.org/web/20241231193833/https://www.whitehouse.gov/briefing-room/statements-releases/2024/07/29/fact-sheet-president-biden-announces-bold-plan-to-reform-the-supreme-court-and-ensure-no-president-is-above-the-law/},
  urldate = {2026-09-26},
  note = {Cited for the July 2024 proposal of a constitutional amendment reversing the immunity holding. Of the three reforms the fact sheet announces, only the first is a constitutional amendment: “He is calling for a constitutional amendment that makes clear no President is above the law or immune from prosecution for crimes committed while in office. This No One Is Above the Law Amendment will state that the Constitution does not confer any immunity from federal criminal indictment, trial, conviction, or sentencing by virtue of previously serving as President.” On term limits it states only that “President Biden supports a system in which the President would appoint a Justice every two years to spend eighteen years in active service on the Supreme Court,” naming no vehicle; on ethics, that “Congress should pass binding, enforceable conduct and ethics rules.” Biden’s \emph{Washington Post} op-ed of the same day (read as reprinted by the American Presidency Project) likewise calls for an amendment only on immunity. Asked aboard Air Force One the same day whether term limits would come by legislation or amendment, a White House official answered “Through legislation that would lead to a constitutional amendment” (press gaggle, American Presidency Project). No joint resolution carrying the administration’s wording was found; related joint resolutions were H.J.Res.\ 193, 118th Cong.\ (introduced by Rep.\ Morelle, 24 July 2024: no immunity for any federal officer on the ground that an act was within official authority, and no presidential self-pardon) and S.J.Res.\ 108, 118th Cong.\ (introduced by Sen.\ Hirono, 1 August 2024: every federal officer “accountable to the law for their actions, both official and unofficial”). Agent-verified 2026-09-26 against the Wayback capture of the fact sheet (bidenwhitehouse.archives.gov returned 404), the op-ed and the gaggle transcript at presidency.ucsb.edu, and the introduced texts of H.J.Res.\ 193 and S.J.Res.\ 108 at govinfo. Not read: the op-ed at washingtonpost.com, the congress.gov records of either joint resolution, and any later administration statement on the vehicle for term limits.}
}

@misc{marbury1803,
  title        = {Marbury v.\ Madison},
  howpublished = {5 U.S. (1 Cranch) 137 (1803)},
  year         = {1803},
  url          = {https://www.law.cornell.edu/supremecourt/text/5/137},
  urldate      = {2026-09-26},
  note         = {Cited for the rule that Congress cannot enlarge the Supreme Court’s original jurisdiction beyond the cases Article III, \S\,2, assigns to it, so that an original action outside those cases must begin in an inferior court. Marshall, C.J., for the Court. At 174: “If congress remains at liberty to give this court appellate jurisdiction, where the constitution has declared their jurisdiction shall be original; and original jurisdiction where the constitution has declared it shall be appellate; the distribution of jurisdiction, made in the constitution, is form without substance,” and “Affirmative words are often, in their operation, negative of other objects than those affirmed.” At 176: the authority given by the Judiciary Act to issue writs of mandamus to public officers “appears not to be warranted by the constitution.” Agent-verified 2026-09-26 against the Cornell LII text of the opinion and the Library of Congress scan of 5 U.S. 137, from which the pin pages are counted (page 174 holds both quoted sentences on original jurisdiction; page 176 the mandamus conclusion). Not checked: whether any later case qualifies the rule in a way bearing on the manuscript’s proposal.},
}

@misc{usafreedom2015,
  author = {{United States Congress}},
  title = {USA FREEDOM Act of 2015, Section 401: Appointment of Amicus Curiae},
  year = {2015},
  howpublished = {Pub. L. No.\ 114-23, \S\,401, 129 Stat. 268, 279 (2015); codified as amended at 50 U.S.C. \S\,1803(i)},
  url = {https://uscode.house.gov/view.xhtml?req=granuleid:USC-prelim-title50-section1803&num=0&edition=prelim},
  urldate = {2026-09-26},
  note = {Cited for the amicus panel added to the Foreign Intelligence Surveillance Court in 2015 and the terms on which it appears. The presiding judges “jointly designate not fewer than 5 individuals to be eligible to serve as amicus curiae” (\S\,1803(i)(1)). As enacted, the court “shall appoint an individual who has been designated \ldots\ to assist such court in the consideration of any application for an order or review that, in the opinion of the court, presents a novel or significant interpretation of the law, unless the court issues a finding that such appointment is not appropriate” and “may appoint an individual or organization to serve as amicus curiae \ldots\ in any instance as such court deems appropriate” (129 Stat. 279). Pub. L. No.\ 118-49, \S\,5(b) (2024), made these “one or more individuals” and added a third head, (i)(2)(A)(iii), requiring appointment for review of section 702 certifications and procedures “unless the court issues a finding that such appointment is not appropriate or is likely to result in undue delay.” In every head the court decides whether the amicus appears: the mandatory head turns on the court’s own opinion that the matter is novel or significant and yields to the court’s own finding. Agent-verified 2026-09-26 against 50 U.S.C. \S\,1803(i) and its 2015 and 2024 amendment notes at uscode.house.gov and the text of Pub. L. 114-23 at govinfo. Not read: Pub. L. 118-49 itself (its effect is taken from the Code’s amendment notes; its short title and Statutes at Large pages are not checked), and FISC practice on how often amici have been appointed.}
}

