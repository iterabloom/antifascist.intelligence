@misc{cipa1980,
  author = {{United States Congress}},
  title = {Classified Information Procedures Act},
  year = {1980},
  howpublished = {Pub. L. No.\ 96-456, 94 Stat. 2025 (1980); codified at 18 U.S.C. app.\ 3 \S\S\,1--16},
  url = {https://uscode.house.gov/view.xhtml?req=granuleid:USC-prelim-title18a-node16-section6&num=0&edition=prelim},
  urldate = {2026-09-26},
  note = {Cited for the criminal-case procedure this book proposes to carry into civil cases in place of state-secrets dismissal. Section 4 (94 Stat. 2025): the court “may authorize the United States to delete specified items of classified information from documents to be made available to the defendant through discovery \ldots\ to substitute a summary of the information for such classified documents, or to substitute a statement admitting relevant facts that the classified information would tend to prove,” on a showing the court may take ex parte. Section 6 (94 Stat. 2026): on the government’s request the court “shall conduct such a hearing,” held in camera if the Attorney General certifies that a public proceeding may disclose classified information (\S\,6(a)); the court “shall grant” a substituted statement or summary “if it finds that the statement or summary will provide the defendant with substantially the same ability to make his defense as would disclosure of the specific classified information” (\S\,6(c)(1)). The case does not always go on: if substitution is refused and the Attorney General files an affidavit objecting to disclosure, “the court shall dismiss the indictment or information; except that, when the court determines that the interests of justice would not be served by dismissal \ldots\ the court shall order such other action \ldots\ as the court determines is appropriate,” including dismissing counts, “finding against the United States on any issue as to which the excluded classified information relates,” or striking testimony (\S\,6(e)(2)).}
}

@misc{jarkesy2024,
  title        = {Securities and Exchange Commission v.\ Jarkesy},
  howpublished = {No.\ 22-859, 603 U.S. 109 (2024)},
  year         = {2024},
  url          = {https://www.law.cornell.edu/supremecourt/text/22-859},
  urldate      = {2026-09-26},
  note         = {Cited for the rule that a civil penalty of the kind a court of law would impose is for a jury in an Article III court, not an agency. Holding (syllabus): “When the SEC seeks civil penalties against a defendant for securities fraud, the Seventh Amendment entitles the defendant to a jury trial.” The opinion: “In this case, the remedy is all but dispositive” (slip op.\ 9); “What determines whether a monetary remedy is legal is if it is designed to punish or deter the wrongdoer, or, on the other hand, solely to ‘restore the status quo’ ”; the close relationship of securities fraud to common-law fraud confirms the result (slip op.\ 8--13). The public-rights exception does not apply (slip op.\ 13--27); the syllabus lists the categories it has covered as “the collection of revenue; aspects of customs law; immigration law; relations with Indian tribes; the administration of public lands; and the granting of public benefits.” The Court did not reach the nondelegation and removal questions. The opinion does not address bonds.},
}

@misc{transunion2021,
  title        = {TransUnion LLC v.\ Ramirez},
  howpublished = {No.\ 20-297, 594 U.S. 413 (2021)},
  year         = {2021},
  url          = {https://www.law.cornell.edu/supremecourt/text/20-297},
  urldate      = {2026-09-26},
  note         = {Cited for the holding that a statutory violation without concrete harm gives no standing in federal court. A Fair Credit Reporting Act class action. Holding (syllabus): “Only plaintiffs concretely harmed by a defendant’s statutory violation have Article III standing to seek damages against that private defendant in federal court.” The opinion: “Article III standing requires a concrete injury even in the context of a statutory violation” (quoting \emph{Spokeo}); “under Article III, an injury in law is not an injury in fact”; and, in conclusion, “No concrete harm, no standing.” The 1,853 class members whose reports went to third parties had standing on the reasonable-procedures claim; the 6,332 whose reports did not, did not.},
}

@misc{loperbright2024,
  title        = {Loper Bright Enterprises v.\ Raimondo},
  howpublished = {No.\ 22-451, 603 U.S. 369 (2024)},
  year         = {2024},
  url          = {https://www.law.cornell.edu/supremecourt/text/22-451},
  urldate      = {2026-09-26},
  note         = {Cited for overruling \emph{Chevron U.S.A.\ Inc.\ v.\ Natural Resources Defense Council} (1984), the end of judicial deference to agency readings of ambiguous statutes, and, with \emph{Dobbs}, as showing that precedent is no obstacle. “Chevron is overruled. Courts must exercise their independent judgment in deciding whether an agency has acted within its statutory authority, as the APA requires. Careful attention to the judgment of the Executive Branch may help inform that inquiry. \ldots\ But courts need not and under the APA may not defer to an agency interpretation of the law simply because a statute is ambiguous.” Two limits: courts still give agency views “due respect” (the \emph{Skidmore} line), and “we do not call into question prior cases that relied on the Chevron framework,” whose holdings “are still subject to statutory stare decisis.”},
}

@misc{westvirginia2022,
  title        = {West Virginia v.\ Environmental Protection Agency},
  howpublished = {No.\ 20-1530, 597 U.S. 697 (2022)},
  year         = {2022},
  url          = {https://www.law.cornell.edu/supremecourt/text/20-1530},
  urldate      = {2026-09-26},
  note         = {Cited for the major-questions doctrine. The opinion names the doctrine and answers the dissent’s objection to the label: it “took hold because it refers to an identifiable body of law that has developed over a series of significant cases all addressing a particular and recurring problem: agencies asserting highly consequential power beyond what Congress could reasonably be understood to have granted”; the agency “must point to ‘clear congressional authorization’ for the power it claims.” Holds that \S\,111(d) of the Clean Air Act did not authorize the Clean Power Plan’s generation-shifting emissions caps (slip op.\ 16--31).},
}

