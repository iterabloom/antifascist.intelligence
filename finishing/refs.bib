@jurisdiction{alaulaqi2014panetta,
  title       = {Al-Aulaqi v. Panetta},
  institution = {United States District Court for the District of Columbia},
  type        = {Opinion},
  number      = {35 F. Supp. 3d 56},
  date        = {2014-04-04},
  url         = {https://www.courtlistener.com/opinion/2668971/al-aulaqi-v-panetta/},
  urldate     = {2026-09-25},
  note        = {Civil Action No.~12-1192 (RMC). Cited for the court finding a due-process claim stated as to the one decedent who was targeted and then holding no remedy available. Suit by the families of three United States citizens killed by drone strikes in Yemen in 2011: Anwar Al-Aulaqi, who was targeted; Samir Khan, killed in the same vehicle; and Anwar’s son Abdulrahman, a “16-year-old high school student,” killed two weeks later by a drone that “targeted someone else.” Fourth Amendment claims failed for all three, because “there was no ‘seizure’.” As to Khan and Abdulrahman, “Plaintiffs have not stated a Fifth Amendment due process claim … Mr. Khan and Abdulrahman Al-Aulaqi were not targeted and their deaths were unanticipated”; the claim “asserts only negligence.” As to Anwar Al-Aulaqi, the court “does not opine … that the drone killing … ‘shocks the conscience’”, and “merely holds that the Complaint states a ‘plausible’ procedural and substantive due process claim.” The next section begins: “Nonetheless, the Court finds no available remedy under U.S. law for this claim.” Special factors preclude a Bivens remedy because the suit would “draw the Court into ‘the heart of executive and military planning and deliberation’” and would implicate foreign policy. The political-question defence was rejected, qualified immunity was not reached, and the Bill of Attainder claim failed for want of legislative action. The opinion’s own introduction dates the second strike “October 14, 2014”, a slip for 2011.}
}

