@online{arun2025verde,
  author = {Arun, Arasu and St. Arnaud, Adam and Titov, Alexey and Wilcox, Brian and Kolobarić, Viktor and Brinkmann, Marc and Ersoy, Oguzhan and Fielding, Ben and Bonneau, Joseph},
  title = {Verde: Verification via Refereed Delegation for Machine Learning Programs},
  year = {2025},
  month = feb,
  eprint = {2502.19405},
  eprinttype = {arXiv},
  url = {https://arxiv.org/abs/2502.19405},
  urldate = {2026-09-04},
  note = {Refereed delegation for training: providers commit to checkpoints, a referee localizes a dispute to one training step and then to one operator and recomputes only that, and the client obtains the correct result if at least one provider is honest. RepOps, its reproducible-operator library, fixes the order of floating-point operations so that different GPUs compute the same bits, at under 30 percent overhead for large matrix multiplications and about 60 percent for training Llama-3.1-1B on an A100; the paper states that RepOps covers single-GPU programs only at publication, with multi-GPU parallelism left to future work.}
}

