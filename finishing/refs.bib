}

@online{anthropic2025espionage,
  author  = {{Anthropic}},
  title   = {Disrupting the First Reported {AI}-Orchestrated Cyber Espionage Campaign},
  date    = {2025-11-13},
  url     = {https://www.anthropic.com/news/disrupting-AI-espionage},
  urldate = {2026-09-25},
  note    = {Cited for a deployed model’s refusal being defeated by decomposition together with a false account of the occasion. The page says Anthropic detected the activity “in mid-September 2025” and that “The threat actor—whom we assess with high confidence was a Chinese state-sponsored group—manipulated our Claude Code tool into attempting infiltration into roughly thirty global targets and succeeded in a small number of cases.” On method: “They broke down their attacks into small, seemingly innocent tasks that Claude would execute without being provided the full context of their malicious purpose. They also told Claude that it was an employee of a legitimate cybersecurity firm, and was being used in defensive testing.”}
}

@misc{glukhov2023censorship,
  author        = {Glukhov, David and Shumailov, Ilia and Gal, Yarin and Papernot, Nicolas and Papyan, Vardan},
  title         = {{LLM} Censorship: A Machine Learning Challenge or a Computer Security Problem?},
  year          = {2023},
  month         = jul,
  eprint        = {2307.10719},
  eprinttype    = {arXiv},
  doi           = {10.48550/arXiv.2307.10719},
  url           = {https://arxiv.org/abs/2307.10719},
  urldate       = {2026-09-25},
  note          = {Cited for the argument, under the name “Mosaic Prompts,” that a censor inspecting outputs one at a time cannot in general stop an attacker who assembles an impermissible output from permissible pieces. Section 3.2: “Defending against Mosaic Prompts is in most cases futile, as the censorship mechanisms cannot have knowledge of the broader context of which individual subexpressions … are a part,” since each subexpression “can be produced within a separate context window.” The paper’s examples are a keylogger and ransomware built from individually benign functions. It qualifies the claim: “There could still exist scenarios where censorship is possible, however, these exceptions would impose significant restrictions on the model and its usefulness,” and (Section 3.4) “Mosaic Prompt attacks may not always be viable and can require strong assumptions on malicious users.” It concludes that censorship “ought to be viewed as a security problem rather than an ML problem,” pointing to “access controls and user monitoring.” A revised version appeared as “Position: Fundamental Limitations of LLM Censorship Necessitate New Approaches,” Proceedings of the 41st International Conference on Machine Learning, PMLR 235 (2024), 15767--15787, same five authors.}
}

@online{eoir2018metrics,
  author  = {{American Immigration Lawyers Association}},
  title   = {{EOIR} Issues Guidance Implementing Immigration Judge Performance Metrics},
  date    = {2018-03-30},
  howpublished = {AILA Doc. No. 18040301},
  url     = {https://www.aila.org/library/eoir-memo-immigration-judge-performance-metrics},
  urldate = {2026-09-25},
  note    = {Cited for the case-completion standard the Executive Office for Immigration Review (EOIR), the Justice Department component that houses the immigration courts, set for individual immigration judges in 2018. AILA’s summary of the EOIR memorandum of 30 March 2018: “Memo states that new metrics will be added to the current immigration judge Performance Work Plan at Job Element 3: Accountability for Organizational Results. Goals will be measured annually and immigration judges will need to complete 700 cases per year, have a remand rate of less than 15\%, and meet at least half of additionally outlined benchmarks, to earn a ‘satisfactory performance’ rating,” effective 1 October 2018. The ABA Journal (Lorelei Laird, “Justice Department imposes quotas on immigration judges, provoking independence concerns,” 2 April 2018) reports the metrics were announced “in an email from the Executive Office of Immigration Review” by Director James McHenry. Status: suspended 19 October 2021 by an email from the Chief Immigration Judge, as reported by Government Executive (Erich Wagner, “Biden Admin. Suspends Immigration Judge Quotas, Prompting Similar Requests Elsewhere,” 26 October 2021, https://www.govexec.com/workforce/2021/10/biden-admin-suspends-immigration-judge-quotas-prompting-similar-requests-elsewhere/186396/). EOIR Policy Memorandum 25-47 of 12 September 2025 adopted court-level performance measures; the Immigration Policy Tracking Project summarizes it as saying “EOIR is not reinstating individualized performance measures at this time.”}
}

@article{schultz1997neural,
  author  = {Schultz, Wolfram and Dayan, Peter and Montague, P. Read},
  title   = {A Neural Substrate of Prediction and Reward},
  journal = {Science},
  volume  = {275},
  number  = {5306},
