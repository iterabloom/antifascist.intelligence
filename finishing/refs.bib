}

@article{weng2013compassion,
  author  = {Weng, Helen Y. and Fox, Andrew S. and Shackman, Alexander J. and Stodola, Diane E. and Caldwell, Jessica Z. K. and Olson, Matthew C. and Rogers, Gregory M. and Davidson, Richard J.},
  title   = {Compassion Training Alters Altruism and Neural Responses to Suffering},
  journal = {Psychological Science},
  volume  = {24},
  number  = {7},
  pages   = {1171--1180},
  year    = {2013},
  doi     = {10.1177/0956797612469537},
  note    = {Cited for two weeks of compassion training increasing costly help to a victim of unfairness. Abstract: “compassion training increased altruistic redistribution of funds to a victim encountered outside of the training context.” Training was guided audio practice “for 30 minutes/day for 2 weeks”; the comparison was an active control trained in reappraisal (n = 20 compassion, n = 21 reappraisal) and an untrained validation sample; the game was played once, after training. In the Redistribution Game a dictator gave the victim \$1 of \$10, and participants could “spend any amount of their own endowment (\$5) to redistribute twice the amount of funds from the dictator to the victim.” Compassion trainees spent \$1.14 and reappraisal trainees \$0.62, t(39) = 2.09, p < .05, d = 0.65.}
}

@article{taylor2000tend,
  author  = {Taylor, Shelley E. and Klein, Laura Cousino and Lewis, Brian P. and Gruenewald, Tara L. and Gurung, Regan A. R. and Updegraff, John A.},
  title   = {Biobehavioral Responses to Stress in Females: Tend-and-Befriend, Not Fight-or-Flight},
  journal = {Psychological Review},
  volume  = {107},
  number  = {3},
  pages   = {411--429},
  year    = {2000},
  doi     = {10.1037/0033-295X.107.3.411},
  note    = {Cited for the tend-and-befriend account of females' stress responses. Abstract: “Although fight-or-flight may characterize the primary physiological responses to stress for both males and females, we propose that, behaviorally, females' responses are more marked by a pattern of ‘tend-and-befriend.’ Tending involves nurturant activities designed to protect the self and offspring that promote safety and reduce distress; befriending is the creation and maintenance of social networks that may aid in this process.” A theoretical review.}
}

@book{noddings1984caring,
  author    = {Noddings, Nel},
  title     = {Caring: A Feminine Approach to Ethics and Moral Education},
  publisher = {University of California Press},
  location  = {Berkeley},
  year      = {1984},
  isbn      = {0-520-05043-6},
  note      = {Cited for care ethics treating partiality toward those in relation as part of care rather than a failure of it. Noddings distinguishes the one-caring and the cared-for, and caring-for from caring-about; she wrote that “we are not obliged to care for starving children in Africa” (p. 86, as quoted by Cassidy, Journal of International Women's Studies 7(1), 2005). Andre's review (Teaching Philosophy 9(1), 1986, 89--90) summarizes: “Starving strangers, or future generations, have no ethical standing unless they are related by ‘circles’ or ‘chains’ to those for whom I care.”}
}

@article{harris2006dehumanizing,
  author  = {Harris, Lasana T. and Fiske, Susan T.},
