@misc{cipa1980,
  author = {{United States Congress}},
  title = {Classified Information Procedures Act},
  year = {1980},
  howpublished = {Pub. L. No.\ 96-456, 94 Stat. 2025 (1980); codified at 18 U.S.C. app.\ 3 \S\S\,1--16},
  url = {https://uscode.house.gov/view.xhtml?req=granuleid:USC-prelim-title18a-node16-section6&num=0&edition=prelim},
  urldate = {2026-09-26},
  note = {Cited for the criminal-case procedure the manuscript proposes to carry into civil cases in place of state-secrets dismissal. Section 4 (94 Stat. 2025): the court “may authorize the United States to delete specified items of classified information from documents to be made available to the defendant through discovery \ldots\ to substitute a summary of the information for such classified documents, or to substitute a statement admitting relevant facts that the classified information would tend to prove,” on a showing the court may take ex parte. Section 6 (94 Stat. 2026): on the government’s request the court “shall conduct such a hearing,” held in camera if the Attorney General certifies that a public proceeding may disclose classified information (\S\,6(a)); the court “shall grant” a substituted statement or summary “if it finds that the statement or summary will provide the defendant with substantially the same ability to make his defense as would disclosure of the specific classified information” (\S\,6(c)(1)). The case does not always go on: if substitution is refused and the Attorney General files an affidavit objecting to disclosure, “the court shall dismiss the indictment or information; except that, when the court determines that the interests of justice would not be served by dismissal \ldots\ the court shall order such other action \ldots\ as the court determines is appropriate,” including dismissing counts, “finding against the United States on any issue as to which the excluded classified information relates,” or striking testimony (\S\,6(e)(2)). The cost of non-disclosure thus falls on the government, which in a criminal case is the party bringing it. Agent-verified 2026-09-26 against 18 U.S.C. app.\ 3 \S\S\,4 and 6 at uscode.house.gov (current codification, both sections unamended since 1980 per their source credits). Not read: \S\S\,1--3, 5 and 7--16, the Statutes at Large printing, and case law applying \S\,6(e).}
}

@misc{jarkesy2024,
  title        = {Securities and Exchange Commission v.\ Jarkesy},
  howpublished = {No.\ 22-859, 603 U.S. 109 (2024)},
  year         = {2024},
  url          = {https://www.law.cornell.edu/supremecourt/text/22-859},
  urldate      = {2026-09-26},
  note         = {Cited for the rule that a civil penalty of the kind a court of law would impose is for a jury in an Article III court, not an agency. Decided June 27, 2024; 6--3. Roberts, C.J., for the Court; Gorsuch, J., concurring, joined by Thomas, J.; Sotomayor, J., dissenting, joined by Kagan and Jackson, JJ. Holding (syllabus): “When the SEC seeks civil penalties against a defendant for securities fraud, the Seventh Amendment entitles the defendant to a jury trial.” The opinion: “In this case, the remedy is all but dispositive” (slip op.\ 9, per the dissent’s “ante, at 9”); “What determines whether a monetary remedy is legal is if it is designed to punish or deter the wrongdoer, or, on the other hand, solely to ‘restore the status quo’ ”; the close relationship of securities fraud to common-law fraud confirms the result (slip op.\ 8--13). The public-rights exception does not apply (slip op.\ 13--27); the syllabus lists the categories it has covered as “the collection of revenue; aspects of customs law; immigration law; relations with Indian tribes; the administration of public lands; and the granting of public benefits.” The Court did not reach the nondelegation and removal questions. The manuscript’s application to a forfeited removal bond is the author’s extension; the opinion does not address bonds. Agent-verified 2026-09-26 against the Cornell LII text of the syllabus and opinion of the Court. Not read: the concurrence and dissent; the U.S. Reports citation comes from \emph{FCC v.\ Consumers’ Research} (2025), which cites “Jarkesy, 603 U.\,S. 109,” not from the bound volume; pin pages are the syllabus’s slip-opinion references.},
}

@misc{transunion2021,
  title        = {TransUnion LLC v.\ Ramirez},
  howpublished = {No.\ 20-297, 594 U.S. 413 (2021)},
  year         = {2021},
  url          = {https://www.law.cornell.edu/supremecourt/text/20-297},
  urldate      = {2026-09-26},
  note         = {Cited for the holding that a statutory violation without concrete harm gives no standing in federal court. Decided June 25, 2021; 5--4. Kavanaugh, J., for the Court, joined by Roberts, C.J., and Alito, Gorsuch and Barrett, JJ.; Thomas, J., dissenting, joined by Breyer, Sotomayor and Kagan, JJ.; Kagan, J., dissenting, joined by Breyer and Sotomayor, JJ. A Fair Credit Reporting Act class action. Holding (syllabus): “Only plaintiffs concretely harmed by a defendant’s statutory violation have Article III standing to seek damages against that private defendant in federal court.” The opinion: “Article III standing requires a concrete injury even in the context of a statutory violation” (quoting \emph{Spokeo}); “under Article III, an injury in law is not an injury in fact”; and, in conclusion, “No concrete harm, no standing.” The 1,853 class members whose reports went to third parties had standing on the reasonable-procedures claim; the 6,332 whose reports did not, did not. Agent-verified 2026-09-26 against the Cornell LII text of the syllabus and opinion of the Court. Not read: the dissents beyond passages located by search. The U.S. Reports citation comes from \emph{Trump v.\ United States} (2024), which cites “TransUnion LLC v.\ Ramirez, 594 U.\,S. 413,” not from the bound volume.},
}

