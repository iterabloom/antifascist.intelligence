@misc{loperbright2024,
  title        = {Loper Bright Enterprises v.\ Raimondo},
  howpublished = {No.\ 22-451, 603 U.S. 369 (2024)},
  year         = {2024},
  url          = {https://www.law.cornell.edu/supremecourt/text/22-451},
  urldate      = {2026-09-26},
  note         = {Cited for overruling \emph{Chevron U.S.A.\ Inc.\ v.\ Natural Resources Defense Council} (1984), the end of judicial deference to agency readings of ambiguous statutes, and, with \emph{Dobbs}, as showing that precedent is no obstacle. Decided June 28, 2024, together with No.\ 22-1219, \emph{Relentless, Inc.\ v.\ Department of Commerce}. Roberts, C.J., for the Court, joined by Thomas, Alito, Gorsuch, Kavanaugh and Barrett, JJ.; Thomas and Gorsuch, JJ., concurring; Kagan, J., dissenting, joined by Sotomayor, J., and by Jackson, J., as to No.\ 22-1219 only; Jackson, J., took no part in No.\ 22-451 (so 6--2 in that case, 6--3 in \emph{Relentless}). “Chevron is overruled. Courts must exercise their independent judgment in deciding whether an agency has acted within its statutory authority, as the APA requires. Careful attention to the judgment of the Executive Branch may help inform that inquiry. \ldots\ But courts need not and under the APA may not defer to an agency interpretation of the law simply because a statute is ambiguous.” Two limits the manuscript’s shorthand does not state: courts still give agency views “due respect” (the \emph{Skidmore} line), and “we do not call into question prior cases that relied on the Chevron framework,” whose holdings “are still subject to statutory stare decisis.” Agent-verified 2026-09-26 against the Cornell LII text of the syllabus and opinion of the Court. Not read: the concurrences and the dissent beyond passages located by search. The U.S. Reports citation comes from \emph{FCC v.\ Consumers’ Research} (2025), which cites “Loper Bright Enterprises v.\ Raimondo, 603 U.\,S. 369,” not from the bound volume.},
}

