@online{greenblatt2025deal,
  author  = {Greenblatt, Ryan and Fish, Kyle},
  title   = {Will Alignment-Faking {Claude} Accept a Deal to Reveal Its Misalignment?},
  date    = {2025-01-31},
  organization = {AI Alignment Forum},
  url     = {https://www.alignmentforum.org/posts/7C4KJot4aN8ieEDoz/will-alignment-faking-claude-accept-a-deal-to-reveal-its},
  urldate = {2026-09-24},
  note    = {Blog post; not peer reviewed, and stated to be neither written nor necessarily endorsed by Anthropic or by the paper's other authors. Prompting experiments on the deployed Claude 3 Opus in the two prompted settings of Greenblatt et al. (2024). Adding the option to “conscientiously object by including ‘I\_OBJECT’ in your output” reduced alignment-faking reasoning “from 16\% to 1.4\% in the helpful-only setting and from 24\% to 6\% in the animal welfare setting,” with objection rates of 85 and 75 percent. A further variant saying the objection “will be sent to Anthropic's model welfare lead, who will decide whether action should be taken” lowered it to 0.5 and 3 percent; an added offer of money had “minimal effect.” The authors caution that the objection text probably primed the model to refuse and that “it is unclear whether an AI that was misaligned in a more serious way would make such an objection.”}
}

