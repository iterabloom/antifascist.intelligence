@book{fischer1998responsibility,
  author = {Fischer, John Martin and Ravizza, Mark},
  title = {Responsibility and Control: A Theory of Moral Responsibility},
  year = {1998},
  publisher = {Cambridge University Press},
  address = {Cambridge},
  series = {Cambridge Studies in Philosophy and Law},
  isbn = {978-0-521-77579-3},
  doi = {10.1017/CBO9780511814594},
  note = {Cited for guidance control: conduct issues from the agent’s own mechanism, and that mechanism is appropriately responsive to reasons; the book states it as an action’s flowing “from the agent’s own, moderately reasons-responsive mechanism” (publisher’s ch. 8 summary). Also cited for the account of moderate reasons-responsiveness and of ownership, and for the origin of the term “reasons-responsive.” Chapter 3 (pp. 62--91) builds “a new notion of reasons-responsiveness that is ‘in between’ strong and weak reasons-responsiveness: moderate reasons-responsiveness,” distinguishing “recognition of reasons and reaction to reasons” and arguing that “the requirements on reasons-recognition are more stringent than those on reasons-reactivity” (publisher’s ch. 3 summary). The book’s summary formula, as quoted by Todd R. Long, “Moderate Reasons-Responsiveness, Moral Responsibility, and Manipulation,” in Campbell, O’Rourke and Shier (eds.), \emph{Freedom and Determinism} (MIT Press, 2004): responsibility “requires that an agent act on a mechanism that is regularly receptive to reasons, some of which are moral reasons, and at least weakly reactive to reasons” (p. 82). Regular receptivity is “an understandable pattern of (actual and hypothetical) reasons-receptivity,” one in which “acceptance of one reason as sufficient implies that a stronger reason must also be sufficient” (p. 71), and the pattern must include moral reasons (p. 77). Weak reactivity requires only that in some possible scenario with the same laws, the same kind of mechanism operating and a sufficient reason to do otherwise, the mechanism issues in doing otherwise (pp. 73--76, as the Stanford Encyclopedia of Philosophy’s entry on free will summarizes it). Ownership: a mechanism becomes the agent’s own through “taking responsibility” for it (ch. 8, pp. 207--239), which requires that the agent see herself as an agent when acting from the mechanism and as an apt target of the reactive attitudes for so acting, and that these beliefs be based appropriately on her evidence (p. 238, as the free-will entry summarizes it). The term “reasons-responsive” is older than this book: the Stanford Encyclopedia’s entry on compatibilism (section 4.4 and supplement B) presents the reasons-responsive account, with its strong and weak forms, as Fischer’s own earlier work, “Responsiveness and Moral Responsibility,” in Ferdinand Schoeman (ed.), \emph{Responsibility, Character, and the Emotions} (Cambridge University Press, 1987), 81--106, and \emph{The Metaphysics of Free Will} (1994), refined in this joint book; the same entry lists earlier accounts of freedom as sensitivity to reasons (Dennett 1984, Nozick 1981, Gert and Duggan 1979, Neely 1974, Fingarette 1972, Glover 1970, MacIntyre 1957).}
}

