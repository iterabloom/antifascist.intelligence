@misc{consumersresearch2025,
  title        = {Federal Communications Commission v.\ Consumers' Research},
  howpublished = {No.\ 24-354, 606 U.S. 656 (2025)},
  year         = {2025},
  url          = {https://www.law.cornell.edu/supremecourt/text/24-354},
  urldate      = {2026-09-26},
  note         = {Cited for the Universal Service Fund as a structural precedent: carriers pay a contribution the agency sets under the statute, a private company administers the Fund under agency control, and the Court upheld the arrangement against a nondelegation challenge. Decided June 27, 2025, together with No.\ 24-422, \emph{SHLB Coalition v.\ Consumers’ Research}; 6--3. Kagan, J., for the Court, joined by Roberts, C.J., and Sotomayor, Kavanaugh, Barrett and Jackson, JJ.; Kavanaugh and Jackson, JJ., concurring; Gorsuch, J., dissenting, joined by Thomas and Alito, JJ. Holding: “The universal-service contribution scheme does not violate the nondelegation doctrine.” Congress’s delegation to the FCC is upheld under the intelligible-principle test, because “the word ‘sufficient’ sets a floor and a ceiling alike” (slip op.\ 19--30); the FCC’s use of the Universal Service Administrative Company is upheld under the private nondelegation doctrine because the Administrator is “broadly subordinate to the Commission” and “the Commission is, throughout, the final authority” (slip op.\ 30--34); the combination theory is rejected (slip op.\ 34--37). Who sets the contribution: “The Commission, in other words, sets the contribution factor to raise just enough money—a ‘sufficient’ amount—to implement universal service as Congress directed”; the Administrator projects expenses and revenues and submits them “to the Commission for approval.” The U.S. Reports citation comes from \emph{Trump v.\ Slaughter} (2026), which cites “Consumers’ Research, 606 U.\,S. 656.” Agent-verified 2026-09-26 against the Cornell LII text of the syllabus and the opinion of the Court. Not read: the concurrences and the dissent; pin pages are the syllabus’s slip-opinion references.},
}

@book{arkin2009governing,
  author = {Arkin, Ronald C.},
  title = {Governing Lethal Behavior in Autonomous Robots},
  year = {2009},
  publisher = {Chapman and Hall/CRC},
  address = {Boca Raton, FL},
  isbn = {978-1-4200-8594-5},
  doi = {10.1201/9781420085952},
  url = {https://doi.org/10.1201/9781420085952},
  urldate = {2026-09-26},
  note = {Cited for the ethical governor: a component that suppresses a system’s lethal action unless the action satisfies constraints derived from the laws of war and the rules of engagement. The publisher describes the book as examining “the philosophical basis, motivation, theory, and design recommendations for the implementation of an ethical control and reasoning system in autonomous robot systems, taking into account the Laws of War and Rules of Engagement.” In the companion technical report (Arkin, Ulam and Duncan, “An Ethical Governor for Constraining Lethal Action in an Autonomous System,” Georgia Institute of Technology GVU Center, GIT-GVU-09-02, 2009), the governor is “a transformer/suppressor of system-generated lethal action to ensure that it constitutes an ethically permissible action, either nonlethal or obligated ethical lethal force,” a “deliberate bottleneck … to force a second opinion prior to the conduct of a privileged lethal behavioral response” (p. 1). Lethal behavior passes only if every prohibition constraint evaluates false and at least one obligating constraint is satisfied; otherwise “lethal behavior is suppressed as impermissible by the ethical governor,” and the lethality permitter transforms the output “into one that does not exhibit lethal behavior” (p. 4). Arkin’s earlier report GIT-GVU-07-11 (2007) lists the governor as the first of four components (ethical governor, ethical behavioral control, ethical adaptor, responsibility advisor), one “which suppresses, restricts, or transforms any lethal behavior … produced by the existing architecture” (p. 20 of the file). “Canonical” is the manuscript’s judgement; Anderson and Waxman called the work “One of the most ambitious of these efforts,” as quoted in Sharkey 2012 (sharkey2012evitability), p. 790. Agent-verified 2026-09-26 against the Taylor \& Francis record the DOI resolves to (title, author, publisher Chapman and Hall/CRC, publication date 27 May 2009), the Routledge product page (ISBN 978-1-4200-8594-5 in the product URL, description), the Just Security book synopsis, and the two technical reports as hosted by Georgia Tech’s Mobile Robot Laboratory. The book itself was not read: its chapter and pages for the governor, and whether its description differs from the reports’, were not checked.}
}

@article{sharkey2012evitability,
  author = {Sharkey, Noel E.},
  title = {The Evitability of Autonomous Robot Warfare},
  journal = {International Review of the Red Cross},
  volume = {94},
  number = {886},
  pages = {787--799},
  year = {2012},
  doi = {10.1017/S1816383112000732},
  url = {https://doi.org/10.1017/S1816383112000732},
  urldate = {2026-09-26},
  note = {Cited for the objection to Arkin’s ethical governor (arkin2009governing) that the rules it checks presuppose discrimination judgments nobody knows how to encode. In general form (p. 789): “The problem for the principle of distinction is that we do not have an adequate definition of a civilian that we can translate into computer code.” Directed at Arkin’s work (p. 790), which Sharkey calls “merely a suggestion for a computer software system for the ethical governance of robot ‘behaviour’”: “Its operation relies entirely on information from systems yet ‘to be developed’ by others sometime in the future. It has no direct access to the real world through sensors or a vision system and it has no means to discriminate between combatant and non-combatant, between a baby and a wounded soldier, or a granny in a wheelchair and a tank. It has no inference engine and certainly cannot negotiate the types of common sense reasoning and battlefield awareness necessary for discrimination or proportionality decisions. There is neither a method for interpreting how the precepts of the laws of war apply in particular contexts nor is there any method for resolving the ambiguities of conflicting laws in novel situations.” The conclusion (p. 798) names the governor among “descriptive terms that presuppose the functionality of their programs (e.g. ethical governor, guilt functions, etc.).” Agent-verified 2026-09-26 against the Cambridge Core record (citation metadata: volume, issue, pages 787--799, DOI, abstract) and the full text of the published article as a Cambridge Core download hosted by the University of Sheffield’s Digital Humanities Institute (printed pages 787--799 legible). Not read: the ICRC’s own copy (refused access).}
}

@inproceedings{greenblatt2024control,
  author = {Greenblatt, Ryan and Shlegeris, Buck and Sachan, Kshitij and Roger, Fabien},
  title = {{AI} Control: Improving Safety Despite Intentional Subversion},
  booktitle = {Proceedings of the 41st International Conference on Machine Learning (ICML 2024)},
  series = {Proceedings of Machine Learning Research},
  volume = {235},
  pages = {16295--16336},
  year = {2024},
  publisher = {PMLR},
  eprint = {2312.06942},
  eprinttype = {arXiv},
  url = {https://proceedings.mlr.press/v235/greenblatt24a.html},
  urldate = {2026-09-26},
  note = {Cited for AI control: treating the model as possibly adversarial and asking which protocols of monitoring, auditing and substitution keep it safe anyway. The paper develops “pipelines of safety techniques (‘protocols’) that are robust to intentional subversion,” using an untrusted strong model (GPT-4), a trusted weaker one (GPT-3.5) and “limited access to high-quality trusted labor” (abstract). Trusted monitoring: GPT-3.5 rates “how suspicious the code looks” (section 1). Auditing: the protocol has trusted labor for “up to 2\% of problems,” and its “central use” is “to audit submitted code”; a caught backdoor shuts the untrusted model down (section 2.2). The audit is targeted, not sampled: the protocols that work “Audit the top 2\% most suspicious code,” while the one protocol that audits without selection, upfront auditing of “the first 2\% of problems,” is a baseline with 15\% safety against the best attack, against 62\% for trusted monitoring (Table 2; sections 3.1.2 and 3.2). Substitution: “defer to trusted” submits a solution written by the trusted model when the untrusted model’s code falls “between top 2\% and top 10\% suspicion,” and trusted editing has the trusted model edit suspicious code (Table 2). Strategic adversary: “With knowledge of the blue team’s protocol, a red team proposes an attack policy” that stands in for the untrusted model, and may use hidden reasoning to make attacks “much sneakier” (section 2, section 2.1). Agent-verified 2026-09-26 against the arXiv abstract page (five versions, v5 of 23 July 2024), the full text of v4 and v5 (the protocol table and the passages quoted are the same in both; sections 1--3 were read, the appendices were not), and the PMLR proceedings page (volume 235, pages 16295--16336, published 8 July 2024). The arXiv v5 describes the ICML paper as “A shortened and modified version of this work”; the PMLR PDF was not read, so section numbering and wording in the proceedings version were not checked.}
}

@article{crootof2016wartorts,
  author = {Crootof, Rebecca},
  title = {War Torts: Accountability for Autonomous Weapons},
  journal = {University of Pennsylvania Law Review},
  volume = {164},
  number = {6},
  pages = {1347--1402},
  year = {2016},
  url = {https://scholarship.law.upenn.edu/penn_law_review/vol164/iss6/1/},
  urldate = {2026-09-26},
  note = {Cited for war torts as state liability for harm in armed conflict where no one has committed a war crime. The article proposes “explicitly identifying ‘war torts’ as serious violations of international humanitarian law that give rise to state responsibility,” alongside war crimes, which give rise to individual criminal liability; “the same action may simultaneously be a war crime and a war tort” (p. 1386). Its motivating case is harm with no criminally liable person: autonomous weapon systems “may take actions that look like war crimes … without any individual acting intentionally or recklessly” (abstract, p. 1347), and war crimes “must be committed by a person acting ‘willfully’” (p. 1350). It argues that “states should be held strictly liable for the actions of the autonomous weapon systems they field” (p. 1394), noting that strict liability “is usually applied to lawful but inherently dangerous activities” (p. 1395). In this article a war tort is still a violation of international humanitarian law; the extension to lawful acts is the 2022 article’s (crootof2022wartorts). Agent-verified 2026-09-26 against the full text of the published article (University of Richmond School of Law repository copy of the \emph{Penn Law Review} print pages 1347--1402) and the \emph{Penn Law Review} article page; the passages quoted were located by searching the text and read in context, and the article was not read cover to cover. No DOI was found for the article.}
}

@article{crootof2022wartorts,
  author = {Crootof, Rebecca},
  title = {War Torts},
  journal = {New York University Law Review},
  volume = {97},
  number = {4},
  pages = {1063--1142},
  year = {2022},
  url = {https://nyulawreview.org/issues/volume-97-number-4/war-torts/},
  urldate = {2026-09-26},
  note = {Cited for war torts as state liability for civilian harm caused in armed conflict, lawful or unlawful, whether or not anyone committed a war crime. Abstract (p. 1063): “no entity is liable for lawful but unintended harmful acts—regardless of how many or how horrifically civilians are hurt. This Article proposes developing an international ‘war torts’ regime, which would require states to pay for both lawful and unlawful acts in armed conflict that cause civilian harm. Just as tort and criminal law coexist and complement each other in domestic legal regimes, war torts and war crimes would overlap but serve different aims.” The ideal regime would “(1) require states to pay compensation for (2) both lawful and unlawful acts in armed conflict that cause civilian harm and (3) have an institutional structure designed to facilitate victim redress” (p. 1109); in an adversarial process “states should be held strictly liable for their harmful acts” (p. 1110); “The legality of the harmful act should not affect whether civilians can receive compensation for it” (p. 1113). A search of the text for “serious harm,” “significant harm,” “de minimis” and “threshold” found no seriousness threshold on the harm; the article proposes limiting liability instead through “pleading requirements, causation cutoffs, and affirmative defenses” (p. 1120). Agent-verified 2026-09-26 against the full text of the article as published on the \emph{NYU Law Review} website (print pages 1063--1142) and its article page; the passages quoted were located by searching the text and read in context, and the article was not read cover to cover. No DOI was found for the article.}
}

@article{wolf1982saints,
  author = {Wolf, Susan},
  title = {Moral Saints},
  journal = {The Journal of Philosophy},
  volume = {79},
  number = {8},
  pages = {419--439},
  year = {1982},
  doi = {10.2307/2026228},
  note = {Cited for the argument that moral sainthood is not an ideal worth striving for. Wolf defines a moral saint as “a person whose every action is as morally good as possible, a person, that is, who is as morally worthy as can be”; argues that the moral virtues “are apt to crowd out the nonmoral virtues, as well as many of the interests and personal characteristics that we generally think contribute to a healthy, well-rounded, richly developed character”; and concludes that “moral perfection, in the sense of moral saintliness, does not constitute a model of personal well-being toward which it would be particularly rational or good or desirable for a human being to strive.” Agent-checked 2026-09-27: the volume, issue, month (August), pages and DOI agree across the Philosophy Documentation Center's listing and two independent search summaries; the three quotations were taken from a University of Notre Dame summary page and match the wording other secondary sources give. The article itself was not read, because the publisher's copy is behind a login.}
}

