  date        = {2005-07-28},
  url         = {https://www.bundesgerichtshof.de/SharedDocs/Pressemitteilungen/DE/2005/2005111.html},
  urldate     = {2026-09-17},
  note        = {Bundesgerichtshof, Third Criminal Senate, on appeal from Landgericht Karlsruhe. The slogan was used in that wording by none of the organizations the provision reaches, “Diese Parole ist im Wortlaut von keiner dieser Organisationen gebraucht worden,” and it is not confusably similar to the Waffen-SS's own slogan or to the Hitler Youth's. Held that the use of a Fantasieparole never used by such an organization, which merely creates the appearance of being one, falls outside \S\,86a. The conviction was set aside and the defendants acquitted.},
  langid      = {german},
}

@jurisdiction{bgh2009bloodhonour,
  title       = {Blood and Honour},
  institution = {Bundesgerichtshof},
  type        = {Judgment},
  number      = {3 StR 228/09},
  date        = {2009-08-13},
  url         = {https://www.hrr-strafrecht.de/3/09/3-228-09.php},
  urldate     = {2026-09-17},
  note        = {Third Criminal Senate, on appeal from Landgericht Gera. Reported at BGHSt 54, 61; NJW 2010, 163; NStZ 2010, 210. Two holdings: a motto of a former National Socialist organization translated into another language is not confusably similar to the original within \S\,86a(2) sentence~2, and the name of an organization under \S\,86(1) Nr.~2 and~4 is not as such an insignium within \S\,86a(2) sentence~1. The name is covered where it has been given a particular form, “in signifikanten Schriftzügen dargestellt.” The association Blood \& Honour Division Deutschland was banned by order of the Federal Minister of the Interior of 12 September 2000 and that ban became final on 13 June 2001.},
  langid      = {german},
}

@jurisdiction{bgh2007hakenkreuz,
  title       = {Durchgestrichenes Hakenkreuz},
  institution = {Bundesgerichtshof},
  type        = {Judgment},
  number      = {3 StR 486/06},
  date        = {2007-03-15},
  url         = {https://www.bundesgerichtshof.de/SharedDocs/Pressemitteilungen/DE/2007/2007036.html},
  urldate     = {2026-09-13},
  note        = {Bundesgerichtshof, Third Criminal Senate, on appeal from Landgericht Stuttgart (judgment of 29 September 2006). Reported at BGHSt 51, 244; NJW 2007, 1602; NStZ 2007, 466. The defendant sold stickers, badges and similar items to the punk scene bearing National Socialist symbols crossed out, smashed or otherwise negated. Held that using a proscribed organization's symbol in a depiction whose content plainly and unmistakably expresses opposition to the organization and rejection of its ideology does not run counter to the protective purpose of \S\,86a and therefore falls outside the offence, the opposition having to be recognizable at first glance. The conviction was set aside and the defendant acquitted.},
  langid      = {german},
}

@misc{muehldorfer2014radikalenerlass,
