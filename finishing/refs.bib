@book{deleuze1987plateaus,
  author = {Deleuze, Gilles and Guattari, F{\'e}lix},
  title = {A Thousand Plateaus: Capitalism and Schizophrenia},
  publisher = {University of Minnesota Press},
  year = {1987},
  address = {Minneapolis},
  note = {Translated by Brian Massumi; originally published in French as Mille Plateaux (Paris: Les {\'E}ditions de Minuit, 1980). Plateau 9, “1933: Micropolitics and Segmentarity.” Molar and molecular are two kinds of segmentarity, rigid and supple, both running at every scale -- not two sizes; an earlier version of this note said state-level and micro-level and was wrong. The same plateau supplies the micro-fascisms that resonate, and the contrast between the conservative totalitarian state and fascism's line of abolition. Also cited for Plateau 13, “The Apparatus of Capture,” whose propositions on the capitalist axiomatic supply the corrected test for the first structural feature: an axiomatic does not refuse a demand, it adds an axiom, modifying its own rules so the demand can be met while nothing that produced the demand is settled. Also cited for Plateau 7, “Year Zero: Faciality,” pages 167--191, where the face is not a natural given but is produced by an abstract machine of faciality (visag{\'e}it{\'e}) that overcodes the head into a surface of signification. The quoted sentence on racism as the determination of degrees of deviance is at page 178, wording checked against two independent scholarly sources quoting it identically. The related claims that the face is not universal but is White Man himself, and that the face is a politics, are used in paraphrase and cited to the plateau rather than to a page: secondary sources place them variously and the pages were not verified.}
}

