  note      = {Cited for the job-guarantee literature's contribution of exit: a public option for work at a living wage that sets a floor private employers must meet. The publisher's description: the book asks us “to imagine a world where the phantom of unemployment is banished and anyone who seeks decent, living-wage work can find it -- guaranteed,” through “a voluntary employment opportunity in public service to anyone who needs it.” Tcherneva's own Job Guarantee FAQ, which draws on her Levy Economics Institute Working Paper 902 (2018) and not on the book, says the program is a “public option for work” whose “work and pay conditions … will become the standard for the economy as a whole.” It adds that “if firms wish to retain these workers, they will need to match not just the pay, but also the benefits and working conditions,” and that “the existence of a public employment option changes the bargaining power of workers in the most precarious forms of employment.” A review by Sheila D. Collins (NJFAN, 22 December 2023) summarizes the book as providing “a minimum labor standard for all jobs and a wage floor that could help to raise wages in other parts of the economy.” Author, title, publisher, series, 140 pages and ISBNs (paperback 978-1-509-54210-9, hardcover 978-1-509-54209-3, e-book 978-1-509-54211-6) were agent-verified 2026-09-24 against the Wiley/Polity product page, which dates the print editions July 2020 and the e-book June 2020. Pages and year were also checked against Open Library (LC class HD5713.T34 2020). The book itself was not read, and the place of publication was not verified against a catalogue record.}
}

@online{hsiao2018vtaiwan,
  author       = {Hsiao, Yu-Tang and Lin, Shu-Yang and Tang, Audrey and Narayanan, Darshana and Sarahe, Claudina},
  title        = {{vTaiwan}: An Empirical Study of Open Consultation Process in {Taiwan}},
  organization = {SocArXiv},
  date         = {2018-07-04},
  doi          = {10.31235/osf.io/xyhft},
  url          = {https://doi.org/10.31235/osf.io/xyhft},
  urldate      = {2026-09-24},
  note         = {Cited for vTaiwan as AI-assisted tooling that expands public deliberation instead of replacing it. In the opinion stage, “Pol.is facilitates open-ended engagement from large groups of people and clusters participants into opinion groups to illuminate the critical aspects of the topic in real-time, using Principal Components Analysis and K-means clustering.” That is statistical machine learning, not a generative model. In the UberX case, the first to use Pol.is, “the Pol.is algorithm then identified different opinion groups based on voting patterns.” Four groups merged into two (45 and 55 per cent of participants); “925 participants took the survey; 145 comments entered into the Pol.is survey and 31,115 votes were gathered.” The clustering fed human deliberation and did not replace it: in a livestreamed in-person consultation with the three ministries, taxi drivers and Uber, “the meeting combined the results from the Pol.is survey with deeper discussion and idea exchanges,” and 1,875 people followed it on the livestream. The paper reports that 26 national issues had gone through the process and that more than 80 per cent led to “decisive government action.” It also names its limits: government authorities control which topics go in, and not every case leads to reform. It is a five-page preprint that was not peer reviewed. One co-author was the government minister overseeing the process, so the figures are self-reported by participants. Authors, title, posting date and DOI were agent-verified 2026-09-24 against Crossref and the OSF API. The quotations were checked against the full text of the posted PDF. The PDF's footer carries an unfilled ACM template DOI, which should be ignored.}
}

