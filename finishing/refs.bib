  urldate = {2026-09-19},
  note = {Cited for subsection (d), the adverse-action notice. (d)(1): “Within
              thirty days (or such longer reasonable time as specified in
              regulations of the Bureau for any class of credit transaction) after
              receipt of a completed application for credit, a creditor shall
              notify the applicant of its action on the application.” (d)(2), first
              sentence: “Each applicant against whom adverse action is taken shall
              be entitled to a statement of reasons for such action from the
              creditor.” (d)(3): “A statement of reasons meets the requirements of
              this section only if it contains the specific reasons for the adverse
              action taken.” So the statute supplies both halves the book's
              third-party notice asks for — that a decision was taken, and the
              specific basis for it — for one class of decision and one class of
              affected party. Agent-verified against the Cornell LII text of 15
              U.S.C. 1691 on 2026-09-19; the enacting and amending public laws are
              not pinned here.}
}

