@misc{menand2026exception,
  author = {Menand, Lev},
  title = {The {F}ederal {R}eserve Exception to the \emph{Slaughter} Rule},
  howpublished = {Just Security},
  year = {2026},
  month = {July},
  url = {https://www.justsecurity.org/145707/slaughter-categorical-rule-cook-exception/},
  urldate = {2026-08-29},
  note = {July 7, 2026. Also posted to SSRN. “Policy as history” is Menand's, in: “We are left with the distinct impression that \emph{Cook} is ‘policy as history’ and what is motivating Chief Justice Roberts and Justice Kavanaugh is a concern with the consequences of extending the \emph{Slaughter} Rule to the Federal Reserve.” It is an impression he arrives at, not a label he applies, which is why the text says he reads the exception as it rather than that he calls it so. The essay's “stable doctrinal equilibrium” was also quoted here until 2026-08-30, as a carve-out with nothing stable under it, and was cut as a misattribution on three counts: the sentence is “Where does this leave us? Probably not with a stable doctrinal equilibrium that could rival the \emph{Humphrey's Executor} Era (1935--2020) or the \emph{Marbury} Era before it (1803--1899)”, which is hedged, is about the whole post-\emph{Slaughter} landscape rather than the Fed carve-out, and is comparative against two named eras rather than absolute. Verified against the essay 2026-08-30.}
}

