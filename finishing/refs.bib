@misc{eu2024aiact,
  author = {{European Parliament and Council of the European Union}},
  title = {Regulation (EU) 2024/1689 of the European Parliament and of the Council of 13 June 2024 Laying Down Harmonised Rules on Artificial Intelligence (Artificial Intelligence Act)},
  year = {2024},
  howpublished = {Official Journal of the European Union, OJ L, 2024/1689, 12.7.2024},
  url = {https://eur-lex.europa.eu/eli/reg/2024/1689/oj},
  urldate = {2026-08-25},
  note = {Article 5 bans a small set of unacceptable-risk practices outright — government social scoring, untargeted scraping of facial images to build recognition databases, real-time remote biometric identification in public spaces outside narrow law-enforcement exceptions, and predictive policing on profiling alone — with those prohibitions applying from 2 February 2025; a larger high-risk tier requires conformity assessment and ongoing monitoring; limited-risk systems face transparency duties; minimal-risk systems are largely unregulated. Article 53(1)(d) requires a provider of a general-purpose model to publish a summary of its training content, against the AI Office's template of 24 July 2025, applying from 2 August 2025 for new models and 2 August 2027 for models already on the market. Article 101 allows the AI Office to fine a noncompliant general-purpose model provider up to 3 percent of global annual turnover or EUR 15 million, whichever is higher, regardless of where the provider is based. Article 51(2) presumes a general-purpose model to have high-impact capabilities, and so to carry systemic risk under Article 51(1)(a), when the cumulative computation used for its training “measured in floating point operations is greater than $10^{25}$”; Article 51(3) lets the Commission amend the threshold by delegated act.}
}

@misc{eu2024productliability,
  author = {{European Parliament and Council of the European Union}},
  title = {Directive (EU) 2024/2853 of the European Parliament and of the Council on Liability for Defective Products and Repealing Council Directive 85/374/EEC},
  year = {2024},
  howpublished = {Official Journal of the European Union, OJ L, 2024/2853},
  url = {https://eur-lex.europa.eu/eli/dir/2024/2853/oj},
  urldate = {2026-09-17},
  addendum = {Article 4(1) brings software within the definition of a product: “all movables… it includes electricity, digital manufacturing files, raw materials and software.” The phrase “including AI system providers within the meaning of Regulation (EU) 2024/1689” is Recital 13, which is not an operative provision. Article 8 makes the economic operator liable irrespective of fault. Article 2(1): “This Directive shall apply to products placed on the market or put into service after 9 December 2026”. Article 6(1) is the closed damage list: “(a) death or personal injury, including medically recognised damage to psychological health; (b) damage to, or destruction of, any property, except… property used exclusively for professional purposes; (c) destruction or corruption of data that are not used for professional purposes.” Article 9 is disclosure of evidence. Article 10(2) presumes defectiveness on failure to disclose, non-compliance with mandatory safety requirements, or obvious malfunction in foreseeable use; Article 10(3) presumes the causal link where the product is defective and the damage is of a kind typically consistent with that defect; Article 10(4) lets a court presume either where technical or scientific complexity makes the claimant's proof excessively difficult and the claimant demonstrates that the defect or the link is likely.}
}

