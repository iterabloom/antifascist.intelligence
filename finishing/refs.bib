@jurisdiction{alaulaqi2014panetta,
  title       = {Al-Aulaqi v. Panetta},
  institution = {United States District Court for the District of Columbia},
  type        = {Opinion},
  number      = {35 F. Supp. 3d 56},
  date        = {2014-04-04},
  url         = {https://www.courtlistener.com/opinion/2668971/al-aulaqi-v-panetta/},
  urldate     = {2026-09-25},
  note        = {Collyer, J. Civil Action No.~12-1192 (RMC). Cited for the court finding a due-process claim stated as to the one decedent who was targeted and then holding no remedy available. Suit by the families of three United States citizens killed by drone strikes in Yemen in 2011: Anwar Al-Aulaqi, who was targeted; Samir Khan, killed in the same vehicle; and Anwar’s son Abdulrahman, a “16-year-old high school student,” killed two weeks later by a drone that “targeted someone else.” Fourth Amendment claims failed for all three, because “there was no ‘seizure’.” As to Khan and Abdulrahman, “Plaintiffs have not stated a Fifth Amendment due process claim … Mr. Khan and Abdulrahman Al-Aulaqi were not targeted and their deaths were unanticipated”; the claim “asserts only negligence.” As to Anwar Al-Aulaqi, the court “does not opine … that the drone killing … ‘shocks the conscience’”, and “merely holds that the Complaint states a ‘plausible’ procedural and substantive due process claim.” The next section begins: “Nonetheless, the Court finds no available remedy under U.S. law for this claim.” Special factors preclude a Bivens remedy because the suit would “draw the Court into ‘the heart of executive and military planning and deliberation’” and would implicate foreign policy. The political-question defence was rejected, qualified immunity was not reached, and the Bill of Attainder claim failed for want of legislative action. The opinion’s own introduction dates the second strike “October 14, 2014”, a slip for 2011. Agent-verified 2026-09-25 against the full reported text as the Caselaw Access Project gives it, pages 56–82. CourtListener refused automated retrieval, so its copy was not read. That the plaintiffs did not appeal comes from search-result summaries of ACLU and Lawfare pages that were not opened.}
}

@online{anthropic2026constitution,
  author = {{Anthropic}},
  title = {Claude's Constitution},
  year = {2026},
  month = jan,
  url = {https://anthropic.com/constitution},
  urldate = {2026-09-17},
  note = {Eighty-four pages, released under CC0 1.0, addressed primarily to the model. Ranks four properties, to be preferred “in the order in which they're listed”: broadly safe, broadly ethical, compliant with Anthropic's guidelines, genuinely helpful. “Broadly safe” is defined as not undermining appropriate human mechanisms to oversee AI during the current phase of development, and the document gives its reason for the ranking --- “not because we think safety is ultimately more important than ethics, but because current models can make mistakes.” Carries a list of hard constraints and a section inviting the model's disagreement. The announcement page is dated 22 January 2026 and commentary dates the document 21 January. The url above is the document itself; the announcement at https://anthropic.com/news/claude-new-constitution summarizes it and does not carry its text, which is where this entry pointed until 2026-09-17.}
