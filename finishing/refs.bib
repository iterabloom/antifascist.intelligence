@misc{callais2026,
  title        = {Louisiana v.\ Callais},
  howpublished = {No.\ 24-109, 608 U.S. \_\_\_ (2026)},
  year         = {2026},
  url          = {https://www.supremecourt.gov/opinions/25pdf/24-109_21o3.pdf},
  urldate      = {2026-09-28},
  note         = {Cited for what a challenger to a map defended as partisan must now prove under Section 2 of the Voting Rights Act. Holding (syllabus): “Because the Voting Rights Act did not require Louisiana to create an additional majority-minority district, no compelling interest justified the State’s use of race in creating SB8, and that map is an unconstitutional racial gerrymander.” The Court holds that “compliance with §2, as properly construed, can provide such an interest” and reads §2 to impose “liability only when the evidence supports a strong inference that the State intentionally drew its districts to afford minority voters less opportunity because of their race”; “Properly understood, §2 thus does not intrude on States’ prerogative to draw districts based on nonracial factors, including to achieve partisan advantage.” Updating the \emph{Gingles} framework, illustrative maps “must meet all the State’s legitimate districting objectives, including traditional districting criteria and the State’s specified political goals,” and racial-bloc-voting analysis must “control[] for party affiliation”; the \emph{Robinson} plaintiffs failed on the totality of circumstances by relying on “evidence that failed to disentangle race from politics.” The syllabus also says the interpretation “does not require abandonment of the framework” of \emph{Thornburg v.\ Gingles}.},
}

