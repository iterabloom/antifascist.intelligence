@article{batson1981empathic,
  author  = {Batson, C. Daniel and Duncan, Bruce D. and Ackerman, Paula and Buckley, Terese and Birch, Kimberly},
  title   = {Is Empathic Emotion a Source of Altruistic Motivation?},
  journal = {Journal of Personality and Social Psychology},
  volume  = {40},
  number  = {2},
  pages   = {290--302},
  year    = {1981},
  doi     = {10.1037/0022-3514.40.2.290},
  note    = {Cited for the easy-escape finding: when escape was easy, most of those led to feel predominantly personal distress left, while most of those led to feel predominantly empathic concern still helped. Two 2 × 2 experiments with female undergraduates watching a confederate, Elaine, receive shocks. Experiment 1 raised empathy by perceived similarity; Experiment 2 manipulated the dominant emotion by misattributing either empathic concern or personal distress to a placebo (“Millentana”). Experiment 2, Table 3, proportions agreeing to trade places (n = 12 per cell): personal distress, easy escape .33, difficult .75; empathic concern, easy .83, difficult .58. The text: “In the distress conditions, where motivation was assumed to be egoistic, the rate of helping was significantly lower under easy than under difficult escape. In the empathy conditions, where motivation was assumed to be at least in part altruistic, the rate of helping remained high, even when escape was easy.” The distress/concern split was manipulated, not measured; a split by self-reported predominant emotion is the subject of Batson, O'Quin, Fultz, Vanderplas and Isen (1983), JPSP 45(3), 706--718.}
}

@article{batson1995immorality,
  author  = {Batson, C. Daniel and Klein, Tricia R. and Highberger, Lori and Shaw, Laura L.},
  title   = {Immorality from Empathy-Induced Altruism: When Compassion and Justice Conflict},
  journal = {Journal of Personality and Social Psychology},
  volume  = {68},
  number  = {6},
  pages   = {1042--1054},
  year    = {1995},
