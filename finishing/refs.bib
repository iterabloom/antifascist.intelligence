@inproceedings{arditi2024refusal,
  author     = {Arditi, Andy and Obeso, Oscar and Syed, Aaquib and Paleka, Daniel and Panickssery, Nina and Gurnee, Wes and Nanda, Neel},
  title      = {Refusal in Language Models Is Mediated by a Single Direction},
  booktitle  = {Advances in Neural Information Processing Systems 37 (NeurIPS 2024)},
  year       = {2024},
  pages      = {136037--136083},
  doi        = {10.52202/079017-4322},
  eprint     = {2406.11717},
  eprinttype = {arXiv},
  url        = {https://arxiv.org/abs/2406.11717},
  urldate    = {2026-10-01},
  note       = {A separate difference-in-means direction is extracted per model across 13 chat models, 1.8B to 72B. Ablating it suppresses refusal; adding it induces refusal on harmless prompts. Table 3 (largest model per family): MMLU, ARC and GSM8K change by at most 1.5 points (drops of at most 1.4); TruthfulQA drops 1.0 to 3.5. Appendix G.1, Table 8 (all 13 models): “We observe less than 1\% performance drop on average”, with Qwen 7B the main exception (GSM8K down 6.3); TruthfulQA drops in every model, by 1.0 to 5.9 points. Appendix J: the direction is already expressed in the corresponding base models. The authors call the result an existence proof and disclaim a semantic reading of the direction.}
}

@online{deeb2024unlearning,
  author     = {Deeb, Aghyad and Roger, Fabien},
  title      = {Do Unlearning Methods Remove Information from Language Model Weights?},
  date       = {2024-10-11},
  eprint     = {2410.08827},
  eprinttype = {arXiv},
  version    = {v3, 2025-02-07},
  url        = {https://arxiv.org/abs/2410.08827},
  urldate    = {2026-10-01},
  note       = {Retraining on an accessible, mutually independent half of the unlearned facts recovers at least 88 percent of the original model's post-retraining accuracy on the held-out half, for RMU, gradient difference and random-incorrect-answer unlearning on Llama 3 8B, when unlearning costs at most 5 percent of retain accuracy. The result holds for pretrained information only: for facts installed by fine-tuning, recovery falls below 35 percent for two of the three methods.}
}

@inproceedings{hu2025jogging,
  author     = {Hu, Shengyuan and Fu, Yiwei and Wu, Zhiwei Steven and Smith, Virginia},
  title      = {Unlearning or Obfuscating? Jogging the Memory of Unlearned {LLMs} via Benign Relearning},
  booktitle  = {International Conference on Learning Representations (ICLR 2025)},
  year       = {2025},
  pages      = {8857--8888},
  eprint     = {2406.13356},
  eprinttype = {arXiv},
  url        = {https://arxiv.org/abs/2406.13356},
  urldate    = {2026-10-01},
  note       = {Relearning on public background text that contains no direct answer to any evaluation query restores the forget-set judge score of a gradient-ascent-unlearned zephyr-7b-beta from 1.27 to 6.2 against an original score of 5.92. Recovery scales with how closely the relearn text correlates with the forget set and with how shallow the unlearning was; RMU resists the attack for free-text generation while its multiple-choice score recovers.}
}

@inproceedings{zhang2025quantization,
  author     = {Zhang, Zhiwei and Wang, Fali and Li, Xiaomin and Wu, Zongyu and Tang, Xianfeng and Liu, Hui and He, Qi and Yin, Wenpeng and Wang, Suhang},
  title      = {Catastrophic Failure of {LLM} Unlearning via Quantization},
  booktitle  = {International Conference on Learning Representations (ICLR 2025)},
  year       = {2025},
  pages      = {74925--74948},
  eprint     = {2410.16454},
  eprinttype = {arXiv},
  url        = {https://arxiv.org/abs/2410.16454},
  urldate    = {2026-10-01},
  note       = {On the MUSE NEWS and BOOKS benchmarks, unlearning methods that carry a utility constraint retain an average of 21 percent of the intended forgotten knowledge at full precision and 83 percent after 4-bit round-to-nearest quantization; 8-bit behaves like full precision, and GPTQ and AWQ behave like RTN. The authors attribute this to utility-preserving unlearning moving weights by less than the 4-bit quantization step. The two averages are the authors' own; Table 1 is the underlying data.}
}

