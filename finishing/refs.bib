  location  = {Princeton, NJ},
  year      = {1990},
  isbn      = {978-0-691-02857-6},
  note      = {Cited for decommodification and for its being characteristic of the social-democratic regime. Two definitions, as quoted with page numbers from the Princeton imprint by Huo, Nelson and Stephens, “Decommodification and Activation in Social Democratic Policy: Resolving the Paradox,” Journal of European Social Policy 18(1) (2008): in decommodifying welfare states “citizens can freely, and without potential loss of job, income, or general welfare, opt out of work when they consider it necessary” (p.~23), and decommodification “refers to the degree to which individuals, or families, can uphold a socially acceptable standard of living independently of market participation” (p.~37). The same article reports that Esping-Andersen “identifies the Nordic welfare states as the most decommodifying type of welfare states, due to the dominant influence of social democratic parties in these countries,” the liberal regimes being “the least decommodifying,” and that he shows (p.~129) a strong positive association between left political power and his decommodification index.}
}

@book{ostrom1990governing,
  author    = {Ostrom, Elinor},
  title     = {Governing the Commons},
  subtitle  = {The Evolution of Institutions for Collective Action},
  series    = {The Political Economy of Institutions and Decisions},
