}

@article{vastfjall2014compassion,
  author  = {Västfjäll, Daniel and Slovic, Paul and Mayorga, Marcus and Peters, Ellen},
  title   = {Compassion Fade: Affect and Charity Are Greatest for a Single Child in Need},
  journal = {PLOS ONE},
  volume  = {9},
  number  = {6},
  pages   = {e100115},
  year    = {2014},
  doi     = {10.1371/journal.pone.0100115},
  note    = {Cited for compassion and giving beginning to fall at two. Abstract: “a decline in compassion may begin with the second endangered life.” In Study 1a (hypothetical donations, Swedish undergraduates) “donations were significantly higher for the single conditions (M = 37.7 SEK) than for the two-children condition (M = 26.3 SEK), t(205) = 5.88, p<.001”; in Study 1b (real donations) the means were 24.5 and 21.5 SEK, t(166) = 1.67, reported as p<.05. The authors: “Studies 1a and 1b thus showed that self-reported affective feelings and donations to victims may start to decline as early as N = 2.” Compassion was measured as self-reported positive affect and, in Study 2, as zygomaticus muscle activity.}
}

@article{slovic2007mass,
  author  = {Slovic, Paul},
  title   = {‘If I Look at the Mass I Will Never Act’: Psychic Numbing and Genocide},
  journal = {Judgment and Decision Making},
  volume  = {2},
  number  = {2},
  pages   = {79--95},
  year    = {2007},
  doi     = {10.1017/S1930297500000061},
  note    = {Cited for psychic numbing. Slovic takes the term from Robert J. Lifton and applies it to a model in which “the emotion or affective feeling is greatest at N = 1 but begins to decline at N = 2 and collapses at some higher value of N that becomes simply ‘a statistic’”; this numbing “leads to apathy and inaction, consistent with what is seen repeatedly in response to mass murder and genocide.” He distinguishes it from psychophysical numbing, in which the value of each added life diminishes “as the total number of lives saved increases” without falling. The fall at two rests on the then-unpublished study later reported by Västfjäll, Slovic, Mayorga and Peters (2014).}
}

@book{hrdy2009mothers,
  author    = {Hrdy, Sarah Blaffer},
  title     = {Mothers and Others: The Evolutionary Origins of Mutual Understanding},
  publisher = {Belknap Press of Harvard University Press},
  location  = {Cambridge, MA},
  year      = {2009},
  isbn      = {978-0-674-03299-6},
  note      = {Cited for humans as cooperative breeders, for alloparents as helpers who were kin and other group members, and for the attunement to other minds arising in infants who depended on several carers. Hrdy's own summary in her CARTA Matrix of Comparative Anthropogeny entry “Cooperative Breeding”: “There may also have been selection for enhanced mental attribution capacities and intersubjective engagement in developmental contexts where infants rely on mutiple [sic] caretakers and had to chronically monitor both mothers and others and where infants and children better at reading intentions and soliciting care were better cared for and better fed (Burkart et al. in press; Hrdy 2009 and references therein).” On why alloparents help, the same entry: “alloparents benefit only to the extent that they a) are related to the parents; b) gain vital experience or c) benefit from enhanced reputation and reciprocal favors including continued group membership.” The publisher's description names the carers as “siblings, aunts, fathers, friends—and, with any luck, grandmothers” and calls the arrangement a “complicated and contingent form of childrearing.”}
}

@book{kittay1999love,
  author    = {Kittay, Eva Feder},
  title     = {Love's Labor: Essays on Women, Equality, and Dependency},
  publisher = {Routledge},
  location  = {New York},
  year      = {1999},
  series    = {Thinking Gender},
  isbn      = {978-0-415-90413-1},
  note      = {Cited for the principle of doulia and for the dependency worker's own dependency. Kittay's gloss on the book in “Love's Labor Revisited,” Hypatia 17(3), 2002, p. 243: “In Love's Labor I try to promote a notion I call doulia, the public responsibility to provide support for the caregiver so that the caregiver can give care without depleting herself and her resources.” In the book Kittay calls the carer's dependency “secondary dependency” (p. 46, per van der Weele et al., Nursing Philosophy 22, 2021, e12327); in “When Caring Is Just and Justice Is Caring,” Public Culture 13(3), 2001, p. 565, she writes that caregivers “become derivatively dependent when they turn their time, attention, and concerns to a dependent other,” “derivative dependency” being a term generally credited to Martha Fineman. Kittay grounds doulia in reciprocity: “we are all some mother's child” (Kittay, Jennings and Wasunna, Journal of Political Philosophy 13(4), 2005, p. 460).}
}

@book{tronto1993moral,
  author    = {Tronto, Joan C.},
  title     = {Moral Boundaries: A Political Argument for an Ethic of Care},
  publisher = {Routledge},
  location  = {New York},
  year      = {1993},
  isbn      = {978-0-415-90642-5},
  note      = {Cited for care as a process in phases whose last, care-receiving, is the response of what was cared for. Tronto names four “analytically separate, but interconnected phases” (p. 106): caring about, taking care of, care-giving and care-receiving. Of the fourth: it “recognizes that the object of care will respond to the care it receives . . . it provides the only way to know that caring needs have actually been met” (pp. 107--108). Both passages as quoted by Pip Seton Bennett, “Degrees of Care: Success, Recognition, and Completion,” Hypatia 38 (2023), 493--510. Tronto later added a fifth phase, caring with (Caring Democracy, 2013).}
}

@book{shakespeare2000help,
