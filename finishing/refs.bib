@misc{gao2026aiacquisitions,
  author = {{U.S. Government Accountability Office}},
  title = {Artificial Intelligence Acquisitions: Agencies Should Collect and Apply Lessons Learned to Improve Future Procurements},
  year = {2026},
  month = apr,
  day = {13},
  howpublished = {GAO-26-107859},
  url = {https://www.gao.gov/products/gao-26-107859},
  urldate = {2026-09-18},
  addendum = {Scope: thirteen AI acquisitions at four agencies --- the Departments of Defense, Homeland Security and Veterans Affairs and the General Services Administration --- and, from that sample, “44 contracts and agreements awarded between September 2018 and February 2025.” Cited for the other-transaction finding: “OTAs do not always include default provisions ordinarily in FAR contracts,” contracting officials deciding what protections to include, and GAO having “previously found that agencies' use of OTAs carries the risk of reduced accountability and transparency compared to FAR-based contracts.” Also for the vehicle behind the agreements: “In July 2025, DOD awarded OTAs with \$200 million ceilings to four leading AI companies.” The six key procurement challenge areas identified by the selected agencies are access to subject matter experts; protections for government data and intellectual property rights; traditional acquisition time frames and contract approaches; requirements definition and contract terms; early testing and continuous evaluation; and artificial intelligence pricing and overall cost. The report's central finding is that the agencies were not yet systematically collecting lessons learned because their policies did not require it. Maven appears in it as the National Geospatial-Intelligence Agency's programme, with lessons-learned sections citing its practices.}
}

