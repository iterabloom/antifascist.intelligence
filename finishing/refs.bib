@jurisdiction{anthropic2026dow,
  title       = {Anthropic PBC v. U.S. Department of War},
  institution = {United States District Court for the Northern District of California},
  type        = {Order on Cross Motions for Summary Judgment},
  number      = {No. 3:26-cv-01996-RFL},
  date        = {2026-08-27},
  url         = {https://www.courtlistener.com/docket/72379655/250/anthropic-pbc-v-us-department-of-war/},
  urldate     = {2026-09-25},
  note        = {ECF No.~250, with the Order of Final Relief (ECF No.~251) and Judgment (ECF No.~252) entered the same day. Cited for the court setting aside the supply-chain-risk designation made under 10 U.S.C. \S\,3252 and holding the penalties unlawful retaliation for the company’s criticism of the administration. The opinion: “Neither the Constitution nor the federal statute invoked by Defendants allows them to impose sweeping penalties based principally on Anthropic’s critique of the Administration’s views”; the challenged actions “were based on a desire to make a public example out of Anthropic for its ‘arrogance’ in criticizing the government”; “The undisputed record shows that the challenged actions constituted unlawful retaliation in violation of the First Amendment, and that Anthropic was denied the pre-deprivation process required under the Fifth Amendment.” The relief order: “The Supply Chain Designation is hereby VACATED, SET ASIDE, and REMANDED pursuant to 5 U.S.C. \S\,706(2)”; the Hegseth Directive’s bar on commercial dealings with the company is likewise vacated and set aside; the remaining defendants are “permanently ENJOINED from implementing, enforcing, or giving effect to the Challenged Actions”; and the order “does not require the Department of War to use Anthropic’s products or services.” Summary judgment went to the government on the ultra vires separation-of-powers claim and as to agencies that took no relevant action; a seven-day administrative stay was refused. The March preliminary injunction (ECF No.~135) is reported at 825 F. Supp. 3d 1101 (N.D. Cal. 2026). Not covered by this order: the parallel designation under 41 U.S.C. \S\,4713, which was reviewable only in the D.C. Circuit. The government’s appeal of the preliminary injunction (9th Cir. No.~26-2011) was held in abeyance on 27 April 2026.}
}

@jurisdiction{anthropic2026dowdccir,
  title       = {Anthropic PBC v. U.S. Department of War},
  institution = {United States Court of Appeals for the District of Columbia Circuit},
  type        = {Opinion},
  number      = {Nos. 26-1049 and 26-1162},
  date        = {2026-09-25},
  url         = {https://media.cadc.uscourts.gov/opinions/docs/2026/09/26-1049-2194984.pdf},
  urldate     = {2026-09-25},
  note        = {Cited for the D.C. Circuit's denial of the petitions for review of the Department's exclusion of Claude from its supply chain under the Federal Acquisition Supply Chain Security Act of 2018, 41 U.S.C. \S\,4713, a designation separate from the one under 10 U.S.C. \S\,3252 that the Northern District of California set aside on 27 August 2026 (No. 26-cv-01996). Slip op. 43: “Accordingly, we deny the petitions for review.” Slip op. 4--5: the First Amendment claim fails “because the Department excluded Anthropic from its supply chain based on the company’s refusal to assent to a contract term that the Department deemed essential, not based on the company’s support for greater governmental regulation of AI technology.” Slip op. 30: the court has “no quarrel” with the Northern District’s conclusions that section 3252 requires bad motive and that Anthropic acted with none, but holds that section 4713 requires none, and does not treat the district court’s judgment as controlling (n.\,1).}
}

