@misc{trump2024immunity,
  date = {2024-07-01},
  title        = {Trump v.\ United States},
  howpublished = {No.\ 23-939, 603 U.S. 593 (2024)},
  url          = {https://www.law.cornell.edu/supremecourt/text/23-939},
  urldate      = {2026-09-26},
  note         = {Cited for the scope of presidential immunity from criminal prosecution. Absolute immunity (Part II--A, slip op.\ 6--9): “the President is absolutely immune from criminal prosecution for conduct within his exclusive sphere of constitutional authority,” authority that is “conclusive and preclusive”; the summary in Part IV speaks of “his core constitutional powers.” The powers the majority names as conclusive and preclusive are the pardon power, the power to remove executive officers, the power “to control recognition determinations” of foreign countries, and (Part III--B--1) the investigative and prosecutorial functions of the Justice Department. Commanding the Armed Forces appears only in an earlier list of the President’s duties, “They include, for instance, commanding the Armed Forces of the United States; granting reprieves and pardons \ldots,” and the majority does not place it among the conclusive and preclusive powers. Presumptive immunity (Part II--B, slip op.\ 9--15): “at least a presumptive immunity from criminal prosecution for a President’s acts within the outer perimeter of his official responsibility”; no immunity for unofficial acts (Part II--C). Evidence (Part III--C, slip op.\ 30--32, joined by five Justices): “Use of evidence about such conduct, even when an indictment alleges only unofficial conduct, would thereby heighten the prospect that the President’s official decisionmaking will be distorted”; n.\,3 lets the prosecutor “point to the public record to show the fact that the President performed the official act” but not “admit testimony or private records of the President or his advisers probing the official act itself.” Barrett, J., does not join Part III--C and on that point agrees with the dissent.},
}

@misc{usc1304judgmentfund,
  author = {{United States Congress}},
  title = {Judgments, Awards, and Compromise Settlements (the Judgment Fund)},
  year = {1982},
  howpublished = {31 U.S.C. \S\,1304; Pub. L. No.\ 97-258, \S\,1, 96 Stat. 917 (1982), as amended; derived from Act of July 27, 1956, ch.\ 748, \S\,1302, 70 Stat. 694},
  url = {https://uscode.house.gov/view.xhtml?req=(title:31+section:1304+edition:prelim)},
  urldate = {2026-09-26},
  note = {Cited for the design of the Judgment Fund as a standing appropriation for judgments against the United States. Subsection (a): “Necessary amounts are appropriated to pay final judgments, awards, compromise settlements, and interest and costs specified in the judgments or otherwise authorized by law when— (1) payment is not otherwise provided for; (2) payment is certified by the Secretary of the Treasury; and (3) the judgment, award, or settlement is payable— (A) under section 2414, 2517, 2672, or 2677 of title 28” (with further heads in (B)--(D)). Treasury’s regulation: “The Judgment Fund is a permanent, indefinite appropriation which is available to pay many judicially and administratively ordered monetary awards against the United States” (31 C.F.R. \S\,256.1(a)). The fund pays only awards payable under a statute listed in (a)(3) and not payable from another appropriation. Certification of payment passed from the Comptroller General to the Secretary of the Treasury by Pub. L. No.\ 104-316, \S\,202(m), 110 Stat. 3843 (1996). Under current practice the losing side asks for payment: “The Department of Justice must normally submit the request for payment from the Judgment Fund” (31 C.F.R. \S\,256.10(a)); for Court of Federal Claims judgments the statute itself provides for payment “on presentation to the Secretary of the Treasury of a certification of the judgment by the clerk and chief judge of the court” (28 U.S.C. \S\,2517(a)).}
}

@misc{usc2680,
