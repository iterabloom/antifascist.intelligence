@misc{nokings2024,
  author = {{United States Senate}},
  title = {No Kings Act},
  year = {2024},
  howpublished = {S.\ 4973, 118th Cong.\ (introduced Aug.\ 1, 2024; placed on the calendar Sept.\ 9, 2024)},
  url = {https://www.govinfo.gov/content/pkg/BILLS-118s4973pcs/html/BILLS-118s4973pcs.htm},
  urldate = {2026-09-26},
  note = {Cited as an example of a statute written to reverse the immunity holding of \emph{Trump v.\ United States} (2024). Introduced by Senator Schumer with 36 cosponsors, read the first time on 1 August 2024 and placed on the calendar on 9 September 2024; no further action is shown, and the 118th Congress ended without enacting it. Section 3(a)(1): a President, former President, Vice President or former Vice President “shall not be entitled to any form of immunity (whether absolute, presumptive, or otherwise) from criminal prosecution for alleged violations of the criminal laws of the United States unless specified by Congress”; \S\,3(a)(2) bars courts from considering whether the conduct was within “conclusive or preclusive constitutional authority” or “related to the official duties” of the office. Section 4 channels review: prosecutions are filed in the applicable district court or the District Court for the District of Columbia, and the Supreme Court is given “no appellate jurisdiction,” on official-act or core-power grounds, to dismiss an indictment, overturn a conviction and the like (\S\,4(a)); challenges to the Act’s constitutionality may be brought only by a President or Vice President, current or former, only within 180 days of enactment (facial) or 90 days of application, only in the District Court for the District of Columbia with appeal to the D.C. Circuit, whose decision “shall be final and not appealable to the Supreme Court,” under a clear-and-convincing presumption of constitutionality (\S\,4(b)); no State court may hear such an action and no court may grant relief sua sponte (\S\,4(c)). Findings rest the Act on the Necessary and Proper Clause and the Exceptions Clause (\S\,2(a)(2), (8)). Agent-verified 2026-09-26 against the placed-on-calendar text at govinfo. Not read: the congress.gov bill record (it refused automated access), so the absence of a House companion is not confirmed; searches found none in the 118th Congress and no reintroduction