@online{werth2010nkvd00447,
  author = {Werth, Nicolas},
  title = {The {NKVD} Mass Secret Operation no. 00447 (August 1937 -- November 1938)},
  year = {2010},
  howpublished = {Sciences Po, Mass Violence and Resistance research network},
  url = {https://www.sciencespo.fr/mass-violence-war-massacre-resistance/en/document/nkvd-mass-secret-operation-n-00447-august-1937-november-1938.html},
  urldate = {2026-09-14},
  note = {Published 24 May 2010. Source of the order's mechanism as the text reports it: round-number quotas per region and republic in two categories, 269,100 persons of whom 76,000 were to be shot, against a four-month deadline; the operation instead ran from August 1937 to mid-November 1938 and condemned some 767,000 people, of whom about 387,000 were shot. On the boards: “The tro{\"i}ki sat behind closed doors, the accused was absent and without any defender,” and in sittings of roughly half a day a troika “went through several hundred cases.” The text's phrase is that sentence rather than an arithmetic of its own, and it does not claim there was no appeal, which this source does not state.}
}

@misc{ghdi1945nerodecree,
  author = {{German History in Documents and Images}},
  title = {Hitler's “Scorched Earth” Decree (Nero Decree) (March 19, 1945) and Albert Speer's Response (March 29, 1945)},
  year = {1945},
  howpublished = {German History in Documents and Images, document 1590},
  url = {https://germanhistorydocs.org/en/nazi-germany-1933-1945/ghdi:document-1590},
  urldate = {2026-09-14},
  note = {The two documents together, and the text cites them for the gap between them. Hitler's order of 19 March 1945 (Bundesarchiv Berlin R 3/1623a) gives its reason as military necessity, opening on the nation's struggle for existence requiring every means, within Reich territory included, to weaken the enemy's fighting power. The reasoning the book's argument turns on is not in the order. It is in Speer's memorandum of 29 March (Bundesarchiv Koblenz N 1340/215), quoting back what he had been told: “For the nation has showed itself to be the weaker one and the future belongs exclusively to the stronger eastern nation.” Speer is there characterising Hitler's stated philosophy, and the text says so rather than attributing the sentence to the order.}
}

